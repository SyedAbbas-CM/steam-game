	# Subtitle
	var sub = Label.new()
	sub.text = "Your equipment has been lost..."
	sub.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	var sub_s = LabelSettings.new()
	sub_s.font_size = 20
