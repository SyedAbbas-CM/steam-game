[gd_resource type="Resource" script_class="QuestDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_definition.gd" id="1_gen"]

[resource]
script = ExtResource("1_gen")
id = "mq02"
title = "What the Dead Left Behind"
summary = "Follow the ichor into the dungeon beneath the farm. Kill blighted creatures and find the carved tablet on the boss floor."
level = 2
location = "haven"
target_location = "haven"
prerequisite = "mq01"
properties = [{
"index": 0,
"name": "Blighted Killed",
"type": "number"
}]
start_script = [{
"cmd": "showDialog",
"name": "Healer Maren",
"options": [{
"name": "I'll clear it out.",
"script": [{
"cmd": "showDialog",
"name": "Healer Maren",
"options": [{
"name": "Understood.",
"script": [{
"cmd": "startQuest"
}]
}],
"portrait": 160,
"text": "Kill whatever blighted creatures you find. And look for anything that explains what's causing this. A tablet, markings — anything."
}]
}],
"portrait": 160,
"text": "You found the source? The ichor leads underground. Whatever's down there, it's spreading."
}]
events = [{
"param": "Skeleton",
"script": [{
"cmd": "increment",
"index": "0"
}],
"type": "kill"
}, {
"param": "Zombie",
"script": [{
"cmd": "increment",
"index": "0"
}],
"type": "kill"
}, {
"param": "haven",
"script": [{
"cmd": "showDialog",
"name": "",
"options": [{
"name": "Take the tablet",
"script": [{
"cmd": "set",
"id": "mq02",
"index": "1",
"value": "1"
}]
}],
"portrait": 0,
"text": "Among the remains you find a stone tablet covered in the same symbols as your brand. The carvings show coordinates — directions to something deeper."
}],
"type": "boss_killed"
}, {
"param": "haven",
"script": [{
"attribute": "session-mq02-1",
"cmd": "if",
"compare": "0",
"operation": "gt",
"script": [{
"cmd": "showDialog",
"name": "Healer Maren",
"options": [{
"name": "Thanks.",
"script": [{
"cmd": "getExp",
"value": "300"
}, {
"cmd": "getItem",
"count": "200",
"name": "Gold"
}, {
"cmd": "completeQuest"
}]
}],
"portrait": 160,
"text": "Let me see... these coordinates point somewhere west. Take this to the Elder — he reads the old language."
}]
}, {
"attribute": "session-mq02-1",
"cmd": "if",
"compare": "1",
"operation": "lt",
"script": [{
"cmd": "showDialog",
"name": "Healer Maren",
"options": [{
"name": "I will.",
"script": []
}],
"portrait": 160,
"text": "Still hunting down there? Be careful. And find that tablet."
}]
}],
"type": "quest"
}]
