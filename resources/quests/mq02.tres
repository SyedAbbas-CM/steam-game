[gd_resource type="Resource" script_class="QuestDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_definition.gd" id="1_gen"]

[resource]
script = ExtResource("1_gen")
id = "mq02"
title = "What the Dead Left Behind"
summary = "The ichor trail leads to the dungeons beneath Ravenhollow itself. Slay 5 blighted undead, defeat the Bone Golem in the depths, and recover the carved tablet."
level = 2
location = "haven"
target_location = "haven"
prerequisite = "mq01"
boss_dungeon = "Haven-Dungeons"
boss_enemy_path = "res://resources/enemies/basic/bone_golem.tres"
boss_dungeon = "Haven-Dungeons"
boss_enemy_path = "res://resources/enemies/basic/bone_golem.tres"
properties = [{
"index": 0,
"name": "Undead Slain",
"type": "number"
}, {
"index": 1,
"name": "Tablet Recovered",
"type": "number"
}]
start_script = [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "You cleansed the Scarecrows, but the root of this blight runs deeper. The ichor trail leads from the farm into the old crypts beneath the graveyard. Descend there, kill what you find, and slay the Bone Golem at the heart of it. Bring back anything you discover.",
"options": [{
"name": "I'll clear it out",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "Slay five of the blighted undead, then find and defeat the Bone Golem. A tablet should be hidden near it — bring it back to me.",
"options": [{
"name": "Understood",
"script": [{
"cmd": "startQuest"
}]
}]
}]
}, {
"name": "Not yet",
"script": []
}]
}]
events = [{
"param": "*",
"script": [{
"cmd": "increment",
"index": "0"
}],
"type": "kill"
}, {
"param": "Bone Golem",
"script": [{
"cmd": "showDialog",
"name": "",
"portrait": 0,
"text": "Among the shattered bones of the Bone Golem you find a stone tablet covered in the same symbols as your brand. The carvings show coordinates — directions to something deeper, westward.",
"options": [{
"name": "Take the tablet",
"script": [{
"cmd": "set",
"id": "mq02",
"index": "1",
"value": "1"
}]
}]
}],
"type": "boss_killed"
}, {
"param": "haven",
"script": [{
"attribute": "session-mq02-1",
"cmd": "if",
"compare": "0",
"operation": "gt",
"script": [{
"attribute": "session-mq02-0",
"cmd": "if",
"compare": "4",
"operation": "gt",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "The tablet... yes, I can read these symbols. They point westward, to the Ashen Wastes. Whatever marked you is waiting there. Rest — and when you return, I'll tell you what I've pieced together.",
"options": [{
"name": "Thank you, Elder",
"script": [{
"cmd": "getExp",
"value": "400"
}, {
"cmd": "getItem",
"count": "500",
"name": "Gold"
}, {
"cmd": "completeQuest"
}]
}]
}]
}]
}, {
"attribute": "session-mq02-1",
"cmd": "if",
"compare": "1",
"operation": "lt",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "Still descending into the crypts? Good. Slay the blighted undead, defeat the Bone Golem, and recover the tablet.",
"options": [{
"name": "I will",
"script": []
}]
}]
}],
"type": "quest"
}]
