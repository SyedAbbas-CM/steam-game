[gd_resource type="Resource" script_class="QuestDefinition" format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = "q12"
title = "Clear the Crypt"
summary = "The crypt beneath Aria is crawling with undead. Slay 15 to secure it."
level = 3
location = "aria"
properties = [{
"index": 0,
"name": "Undead Slain",
"type": "number"
}]
start_script = [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "The crypt grows more dangerous by the day. We need 15 undead slain before they spill out into the village. Can you handle it?",
"options": [{
"name": "Consider it done",
"script": [{
"cmd": "startQuest",
"id": "q12"
}]
}, {
"name": "Not yet",
"script": []
}]
}]
events = [{
"type": "kill",
"param": "Skeleton",
"script": [{
"cmd": "increment",
"index": "0"
}]
}, {
"type": "kill",
"param": "Ghost",
"script": [{
"cmd": "increment",
"index": "0"
}]
}, {
"type": "kill",
"param": "Ghoul",
"script": [{
"cmd": "increment",
"index": "0"
}]
}, {
"type": "kill",
"param": "Skeleton Archer",
"script": [{
"cmd": "increment",
"index": "0"
}]
}, {
"type": "kill",
"param": "Bone Guard",
"script": [{
"cmd": "increment",
"index": "0"
}]
}, {
"type": "kill",
"param": "Zombie",
"script": [{
"cmd": "increment",
"index": "0"
}]
}, {
"type": "quest",
"param": "aria",
"script": [{
"attribute": "session-q12-0",
"cmd": "if",
"compare": "15",
"operation": "lt",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "The undead still threaten us. Keep fighting, hero!",
"options": [{
"name": "I won't stop",
"script": []
}]
}]
}, {
"attribute": "session-q12-0",
"cmd": "if",
"compare": "14",
"operation": "gt",
"script": [{
"cmd": "getItem",
"count": "800",
"name": "Gold"
}, {
"cmd": "getExp",
"value": "500"
}, {
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "The crypt is secure once more! You are a true hero. Here is 800 gold and the village's gratitude.",
"options": [{
"name": "My pleasure",
"script": []
}]
}, {
"cmd": "completeQuest"
}]
}]
}]
