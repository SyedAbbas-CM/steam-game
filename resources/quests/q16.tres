[gd_resource type="Resource" script_class="QuestDefinition" format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = "q16"
title = "Strange Bones"
summary = "Bone Guards are appearing in unusual numbers in the crypts. Something stirs below. Kill 10 Bone Guards."
level = 5
location = "aria"
properties = [{
"index": 0,
"name": "Bone Guards Killed",
"type": "number"
}]
start_script = [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "Something is wrong in the crypts. Bone Guards are appearing in numbers we've never seen before. We need someone to thin their ranks. Can you kill 10 of them?",
"options": [{
"name": "I'll investigate",
"script": [{
"cmd": "startQuest",
"id": "q16"
}]
}, {
"name": "Not yet",
"script": []
}]
}]
events = [{
"type": "kill",
"param": "Bone Guard",
"script": [{
"cmd": "increment",
"index": "0"
}]
}, {
"type": "quest",
"param": "aria",
"script": [{
"attribute": "session-q16-0",
"cmd": "if",
"compare": "10",
"operation": "lt",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "The Bone Guards still march. Keep fighting, hero!",
"options": [{
"name": "I will",
"script": []
}]
}]
}, {
"attribute": "session-q16-0",
"cmd": "if",
"compare": "9",
"operation": "gt",
"script": [{
"cmd": "getItem",
"count": "1000",
"name": "Gold"
}, {
"cmd": "getExp",
"value": "600"
}, {
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "You've culled their numbers, but I fear this is only the beginning. Something deeper is driving them to the surface. Here is 1000 gold for now.",
"options": [{
"name": "What do you mean?",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "Dark energy pulses from the deep crypt. I'll need your help again soon. Rest up, adventurer.",
"options": [{
"name": "I'll be ready",
"script": []
}]
}]
}]
}, {
"cmd": "completeQuest"
}]
}]
}]
