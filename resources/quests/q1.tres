[gd_resource type="Resource" script_class="QuestDefinition" format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_definition.gd" id="1_8mohw"]

[resource]
script = ExtResource("1_8mohw")
id = "q1"
title = "Them Bones"
summary = "The Elder has asked you to cull 20 Skeletons that have risen near the graveyard outside of town."
level = 1
location = "haven"
target_location = "barrows"
giver_npc = "Elder"
properties = [{
"index": 0,
"name": "Skeletons Killed",
"type": "number"
}]
start_script = [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "Adventurer, we have a problem. The graveyard outside town is overrun with Skeletons — they've been rising faster than we can deal with. There's a bounty of 500 gold for anyone who can cull 20 of them.",
"options": [{
"name": "I'll take care of it",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "Good. Head to the graveyard area and put those bones back in the ground. Return to me when you've dealt with 20 of them.",
"options": [{
"name": "On my way",
"script": [{
"cmd": "spawnEnemies",
"zone": "barrows",
"enemy": "Skeleton",
"count": "20",
"x": "2",
"y": "3",
"w": "16",
"h": "22"
}, {
"cmd": "startQuest",
"id": "q1"
}]
}]
}]
}, {
"name": "Not interested",
"script": []
}]
}]
events = [{
"param": "Skeleton",
"script": [{
"cmd": "increment",
"index": "0"
}],
"type": "kill"
}, {
"param": "haven",
"script": [{
"attribute": "session-q1-0",
"cmd": "if",
"compare": "20",
"operation": "lt",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "Still hunting Skeletons? Keep at it — the graveyard won't clear itself.",
"options": [{
"name": "On it",
"script": []
}]
}]
}, {
"attribute": "session-q1-0",
"cmd": "if",
"compare": "19",
"operation": "gt",
"script": [{
"cmd": "getItem",
"count": "500",
"name": "Gold"
}, {
"cmd": "getExp",
"value": "300"
}, {
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "Twenty Skeletons down. Well done, adventurer. The graveyard should be quieter now. Here's your reward — 500 gold, as promised. Come back if you're looking for more work.",
"options": [{
"name": "Thank you, Elder",
"script": []
}]
}, {
"cmd": "completeQuest"
}]
}],
"type": "quest"
}]
