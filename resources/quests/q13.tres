[gd_resource type="Resource" script_class="QuestDefinition" format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = "q13"
title = "Pest Control"
summary = "The graveyard is overrun with ghosts. Kill 10 of them to restore peace."
level = 2
location = "aria"
target_location = "aria-g"
properties = [{
"index": 0,
"name": "Ghosts Killed",
"type": "number"
}]
start_script = [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "The graveyard to the south is haunted by restless spirits. Will you put 10 ghosts to rest?",
"options": [{
"name": "I'll do it",
"script": [{
"cmd": "startQuest",
"id": "q13"
}]
}, {
"name": "Not now",
"script": []
}]
}]
events = [{
"type": "kill",
"param": "Ghost",
"script": [{
"cmd": "increment",
"index": "0"
}]
}, {
"type": "quest",
"param": "aria",
"script": [{
"attribute": "session-q13-0",
"cmd": "if",
"compare": "10",
"operation": "lt",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "Still hunting ghosts? Keep at it, adventurer!",
"options": [{
"name": "On it!",
"script": []
}]
}]
}, {
"attribute": "session-q13-0",
"cmd": "if",
"compare": "9",
"operation": "gt",
"script": [{
"cmd": "getItem",
"count": "600",
"name": "Gold"
}, {
"cmd": "getExp",
"value": "400"
}, {
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "The spirits are at peace, thanks to you! Here is 600 gold for your bravery.",
"options": [{
"name": "Thanks",
"script": []
}]
}, {
"cmd": "completeQuest"
}]
}]
}]
