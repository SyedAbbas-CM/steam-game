"script": [{
"attribute": "count-King's Crown",
"cmd": "if",
"compare": "1",
"operation": "lt",
"script": [{
"cmd": "showDialog",
"name": "Chief Komba",
"options": [{
"name": "I shall not fail!",
"script": []
}],
"portrait": 158,
"text": "Have you found it yet?"
}]
}, {
