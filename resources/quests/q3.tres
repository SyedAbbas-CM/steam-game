[resource]
script = ExtResource("1_qn60s")
id = "q3"
title = "Pelting Them"
level = 11
location = "aria"
target_location = "vly1"
start_script = [{
"cmd": "showDialog",
"name": "Elder",
"options": [{
"name": "Ok",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"options": [{
"name": "Ok",
"script": [{
"cmd": "startQuest",
"id": "q3"
}]
}],
"portrait": 147,
"text": "If you gather me 10 pelts, I can make you something special, will you?"
}]
}, {
"name": "Later",
"script": []
}],
"portrait": 147,
"text": "Return here with the pelts"
}]
events = [{
"param": "aria",
"script": [{
"attribute": "count-Dog Pelt",
"cmd": "if",
"compare": "10",
"operation": "lt",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"options": [{
"name": "Yes Sir!",
"script": []
}],
"portrait": 147,
"text": "Bring me those pelts young hero!"
}]
}, {
"attribute": "count-Dog Pelt",
"cmd": "if",
"compare": "9",
"operation": "gt",
"script": [{
"attribute": "hasFreeSlot",
"cmd": "if",
"compare": "1",
"operation": "neq",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"options": [{
"name": "Ok",
"script": []
}],
"portrait": 147,
"text": "Good work, but you have no room for your reward. Come back later."
}]
}, {
"attribute": "hasFreeSlot",
"cmd": "if",
"compare": "1",
"operation": "eq",
"script": [{
"cmd": "getExp",
"value": "1000"
}, {
"cmd": "takeItem",
"count": "10",
"name": "Dog Pelt"
}, {
"cmd": "getItem",
"count": "",
"name": "Pelt Cloak"
}, {
"cmd": "showDialog",
"name": "Elder",
"options": [{
"name": "Thanks",
"script": []
}],
"portrait": 147,
"text": "Ah fantastic, give me a moment, there we go, one cloak!"
}, {
"cmd": "completeQuest"
}]
}]
}],
"type": "quest"
}]
