[gd_resource type="Resource" script_class="QuestDefinition" format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = "q18"
title = "The Bone King's Throne"
summary = "A massive Bone Giant commands the undead from the deepest crypt. Slay 5 Bone Giants to end the rising darkness."
level = 7
location = "aria"
properties = [{
"index": 0,
"name": "Bone Giants Slain",
"type": "number"
}]
start_script = [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "The Bone King must fall. Descend to the deepest crypts and destroy 5 Bone Giants. Only then will the undead cease their march on our village.",
"options": [{
"name": "For Aria!",
"script": [{
"cmd": "startQuest",
"id": "q18"
}]
}, {
"name": "I need to prepare",
"script": []
}]
}]
events = [{
"type": "kill",
"param": "Bone Giant",
"script": [{
"cmd": "increment",
"index": "0"
}]
}, {
"type": "quest",
"param": "aria",
"script": [{
"attribute": "session-q18-0",
"cmd": "if",
"compare": "5",
"operation": "lt",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "The Bone Giants still rule below. You must destroy them all!",
"options": [{
"name": "I'll keep fighting",
"script": []
}]
}]
}, {
"attribute": "session-q18-0",
"cmd": "if",
"compare": "4",
"operation": "gt",
"script": [{
"cmd": "getItem",
"count": "1500",
"name": "Gold"
}, {
"cmd": "getExp",
"value": "1000"
}, {
"cmd": "getItem",
"name": "Bone Staff",
"count": "1"
}, {
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "The Bone King is no more! JohnBurn Village is safe again. You have earned this Bone Staff, taken from the throne itself, and 1500 gold.",
"options": [{
"name": "What now?",
"script": [{
"cmd": "showDialog",
"name": "Elder",
"portrait": 147,
"text": "You've outgrown our little village, hero. The wilds beyond the northern gate hold greater challenges, and greater rewards. The guard will let you pass. Go forth and make Aria proud!",
"options": [{
"name": "Thank you, Elder",
"script": []
}]
}]
}]
}, {
"cmd": "completeQuest"
}]
}]
}]
