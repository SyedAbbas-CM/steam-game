"map": "tor1",
"x": "31",
"y": "5"
}]
}],
"portrait": 223,
"text": "Come back when you have the cash!"
}]
}]
}, {
"name": "No",
"script": []
}],
"portrait": 223,
"text": "Right, raise the sail, we've got a punter!"
}]
}, {
