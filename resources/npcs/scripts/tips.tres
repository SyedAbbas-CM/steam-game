[gd_resource type="Resource" script_class="NpcScriptData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/npcs/npc_script_data.gd" id="1"]

[resource]
script = ExtResource("1")
commands = [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "Welcome young hero, I've been adventuring many years. Would you like some advice?", "options": [{ "name": "No", "script": [] }, { "name": "Yes", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "I can tell you how to get back to town quickly, how to play, and about your stats. Which?", "options": [{ "name": "Town", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "Buy the town portal scroll! Using it will summon a portal right back to town!", "options": [{ "name": "Great!", "script": [] }] }] }, { "name": "Play", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "I can tell you about movement lock and quick slots. Understand?", "options": [{ "name": "Lock", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "Holding down on the wait button (top right) toggles movement lock on and off.", "options": [{ "name": "Right?", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "When enabled it stops you running off into battle with an accidental tap!", "options": [{ "name": "OK!", "script": [] }] }] }] }] }, { "name": "Slots", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "Quick slots let you access your items quickly. Tap them in the bottom left.", "options": [{ "name": "How do I setup?", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "Go to your inventory, tap a slot then an item to put in it. Simple.", "options": [{ "name": "OK!", "script": [] }] }] }] }] }] }] }, { "name": "Stats", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "I can tell you about Zen, Rage and Charge. Which don't you understand?", "options": [{ "name": "Zen", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "Waiting before attack (skip turn) will increase your zen! / / This improves your accuracy with bows!", "options": [{ "name": "Thanks!", "script": [] }] }] }, { "name": "Rage", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "As a warrior, rage goes up when you get hit! / / The more angry you are, the more damage you do!", "options": [{ "name": "Thanks!", "script": [] }] }] }, { "name": "Charge", "script": [{ "cmd": "showDialog", "name": "Old Man", "portrait": 150, "text": "Charge is the magic you use to cast spells. It goes up over time. / / You can also get potions to help!", "options": [{ "name": "Thanks!", "script": [] }] }] }] }] }] }] }] }]
