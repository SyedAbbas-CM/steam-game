{
  "name": "loy-world-editor",
  "version": "1.0.0",
  "description": "Legends of Yore World Map Editor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.loy.world-editor",
    "productName": "LoY World Editor",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "mac": {
      "target": "dir"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "dir"
    }
  }
}
