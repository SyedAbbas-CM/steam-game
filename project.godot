; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="New Game Project"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/systems/game_manager.gd"
QuestManager="*res://scripts/quests/quest_manager.gd"
SFXManager="*res://scripts/systems/sfx_manager.gd"
VFXManager="*res://scripts/systems/vfx_manager.gd"
FactionManager="*res://scripts/systems/faction_manager.gd"
LightingManager="*res://scripts/systems/lighting_manager.gd"
NoiseSystem="*res://scripts/systems/noise_system.gd"
PerkManager="*res://scripts/stats/perk_manager.gd"
CoopSession="*res://scripts/systems/coop_session.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="viewport"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/world_baker/plugin.cfg")

