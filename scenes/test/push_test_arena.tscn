[sub_resource type="GDScript" id="FloorPaint"]
script/source = "extends ColorRect
func _ready():
	# Big tinted floor under everything for visibility
	color = Color(0.10, 0.11, 0.13, 1.0)
	size = Vector2(420, 320)
	position = -size * 0.5
	z_index = -10
"

[sub_resource type="GDScript" id="GridPaint"]
script/source = "extends Node2D
func _draw():
	# Light grid every 16 px so you can see push distance and bounce
	var w = 420.0
	var h = 320.0
	var step = 16.0
	var col = Color(1, 1, 1, 0.06)
	var x = -w * 0.5
	while x <= w * 0.5:
		draw_line(Vector2(x, -h * 0.5), Vector2(x, h * 0.5), col, 1.0)
		x += step
	var y = -h * 0.5
	while y <= h * 0.5:
		draw_line(Vector2(-w * 0.5, y), Vector2(w * 0.5, y), col, 1.0)
		y += step
"

