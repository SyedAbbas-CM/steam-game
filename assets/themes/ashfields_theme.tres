; -- TooltipPanel --
TooltipPanel/styles/panel = SubResource("sb_tooltip")
TooltipLabel/colors/font_color = Color(0.973, 0.980, 0.984, 1.0)

; -- ProgressBar --
ProgressBar/styles/background = SubResource("sb_progress_bg")
ProgressBar/styles/fill = SubResource("sb_progress_fill")
