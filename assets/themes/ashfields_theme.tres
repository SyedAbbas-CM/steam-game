[gd_resource type="Theme" load_steps=23 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/VT323-Regular.ttf" id="font_body"]

; Ashfields theme. Gothic dark + gold accent. Generated from ui-ux-pro-max query
; "gothic dark fantasy" (palette: Theater/Cinema + Luxury). Hex below is the
; canonical palette for the game's UI work.
;
;   bg_deep      #0F0F1A
;   bg_panel     #1C1917
;   bg_hover     #312E81
;   border       #44403C
;   border_lit   #78716C
;   text         #F8FAFC
;   text_muted   #A8A29E
;   accent_gold  #CA8A04
;   accent_gold2 #EAB308   (brighter, for hover)
;   accent_blood #991B1B   (HP / danger)
;   accent_mp    #7C3AED   (MP / arcane)

; -- StyleBoxFlat: panel surface --
[sub_resource type="StyleBoxFlat" id="sb_panel"]
