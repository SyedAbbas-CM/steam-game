[resource]
; -- Global default font + sizes (VT323 reads small; bumped again to 28) --
default_font = ExtResource("font_body")
default_font_size = 28

; -- Label --
Label/colors/font_color = Color(0.973, 0.980, 0.984, 1.0)
Label/colors/font_outline_color = Color(0, 0, 0, 1.0)
Label/colors/font_shadow_color = Color(0, 0, 0, 0)
Label/constants/outline_size = 2

; -- Button --
Button/colors/font_color = Color(0.973, 0.980, 0.984, 1.0)
Button/colors/font_hover_color = Color(0.918, 0.702, 0.031, 1.0)
Button/colors/font_pressed_color = Color(0.792, 0.541, 0.016, 1.0)
Button/colors/font_disabled_color = Color(0.659, 0.635, 0.616, 0.6)
Button/colors/font_outline_color = Color(0, 0, 0, 1.0)
Button/constants/outline_size = 2
Button/font_sizes/font_size = 26
Button/styles/normal = SubResource("sb_btn_normal")
Button/styles/hover = SubResource("sb_btn_hover")
Button/styles/pressed = SubResource("sb_btn_pressed")
Button/styles/disabled = SubResource("sb_btn_disabled")
Button/styles/focus = SubResource("sb_btn_focus")

; -- Panel / PanelContainer --
Panel/styles/panel = SubResource("sb_panel")
