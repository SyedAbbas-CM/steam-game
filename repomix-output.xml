    "Lava Lizard": {
        "attack_type": AT["BEAM"],
        "boss_phases": 2,
        "phase_2_attack": AT["SPIRAL"],
        "phase_2_bullet_count": 10,
        "leaves_trail": True,
        "trail_type": "fire",
    },
    "Golgothra": {
        "attack_type": AT["BURST"],
        "boss_phases": 3,
        "phase_2_attack": AT["SPIRAL"],
