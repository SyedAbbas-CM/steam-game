func _start_dash() -> void:
	# Consume stamina
	stamina -= DASH_STAMINA_COST
	_stamina_regen_delay = 1.0  # 1s delay before regen starts
	stamina_changed.emit(stamina)

	_is_dashing = true
	_dash_timer = DASH_DURATION
