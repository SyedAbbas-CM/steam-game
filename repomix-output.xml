var _last_known_player_dir: Vector2 = Vector2.ZERO
# Wrestling throw
var _thrown_timer: float = 0.0
var _thrown_velocity: Vector2 = Vector2.ZERO
var _thrower_dmg: int = 0
var _loy_sprite: Sprite2D  # separate sprite for LoY characters
