<file path="scripts/dungeon/mutation_processor.gd">
class_name MutationProcessor
extends Node

var active_mutations: Array[MutationDefinition] = []

func add_mutation(mutation: MutationDefinition) -> void:
	# Check stacking
	var current_stacks = 0
	for m in active_mutations:
		if m.type == mutation.type:
			current_stacks += 1
	if current_stacks < mutation.max_stacks:
		active_mutations.append(mutation)

func get_strength(type: MutationDefinition.MutationType) -> float:
	var total: float = 0.0
	for m in active_mutations:
		if m.type == type:
			total += m.strength * m.tier
	return total

func has_mutation(type: MutationDefinition.MutationType) -> bool:
	for m in active_mutations:
		if m.type == type:
			return true
	return false

# Called when a bullet hits an enemy
func on_bullet_hit(bullet: Node2D, target: Node2D, player: Node2D) -> void:
	# Life steal
	var life_steal = get_strength(MutationDefinition.MutationType.LIFE_STEAL)
	if life_steal > 0.0 and player.has_method("heal"):
		var heal_amount = int(max(1, bullet.damage * life_steal * 0.1))
		player.heal(heal_amount)

	# Exploding bullets
	var explode_strength = get_strength(MutationDefinition.MutationType.EXPLODING_BULLETS)
	if explode_strength > 0.0:
		_spawn_explosion(target.global_position, int(bullet.damage * explode_strength * 0.5))

	# Chain lightning
	var chain_strength = get_strength(MutationDefinition.MutationType.CHAIN_LIGHTNING)
	if chain_strength > 0.0:
		_chain_damage(target, int(bullet.damage * chain_strength * 0.3), 3)

# Called when an enemy dies
func on_enemy_killed(enemy_pos: Vector2, player: Node2D) -> void:
	# Vampiric burst
	var vamp = get_strength(MutationDefinition.MutationType.VAMPIRIC_BURST)
	if vamp > 0.0 and player.has_method("heal"):
		player.heal(int(max(1, vamp * 2)))

	# Shield on kill
	var shield = get_strength(MutationDefinition.MutationType.SHIELD_ON_KILL)
	if shield > 0.0 and player.has_method("add_shield"):
		player.add_shield(int(shield))

# Modify bullet properties before firing
func modify_bullet(bullet: Node2D) -> void:
	# Pierce
	var pierce = get_strength(MutationDefinition.MutationType.BULLET_PIERCE)
	if pierce > 0.0:
		bullet.pierce_count += int(pierce)

	# Homing
	var homing = get_strength(MutationDefinition.MutationType.HOMING_SHOTS)
	if homing > 0.0:
		bullet.homing_strength = homing * 3.0

func _spawn_explosion(pos: Vector2, damage: int) -> void:
	# Create AoE damage at position
	var enemies = get_tree().get_nodes_in_group("enemy")
	var aoe_radius = 30.0
	for enemy in enemies:
		if not is_instance_valid(enemy):
			continue
		if enemy.global_position.distance_to(pos) < aoe_radius:
			if enemy.has_method("take_damage"):
				enemy.take_damage(damage)

func _chain_damage(source: Node2D, damage: int, max_chains: int) -> void:
	var hit_enemies: Array[Node2D] = [source]
	var current = source
	var chain_range = 40.0

	for _i in range(max_chains):
		var nearest: Node2D = null
		var nearest_dist: float = chain_range

		for enemy in get_tree().get_nodes_in_group("enemy"):
			if not is_instance_valid(enemy) or enemy in hit_enemies:
				continue
			var dist = current.global_position.distance_to(enemy.global_position)
			if dist < nearest_dist:
				nearest_dist = dist
				nearest = enemy

		if nearest:
			if nearest.has_method("take_damage"):
				nearest.take_damage(damage)
			hit_enemies.append(nearest)
			current = nearest
		else:
			break
</file>

<file path="scripts/dungeon/web_bridge_generator.gd">
class_name WebBridgeGenerator
extends RefCounted

# Returns Array of Vector2i positions (local to room) where spider webs go
static func generate_bridges(floor_mask: Array, liquid_mask: Array, bridge_density: float, connections: Dictionary, w: int, h: int) -> Array:
	if bridge_density <= 0.0:
		return []

	var web_positions: Array = []
	var web_set: Dictionary = {}
	var cx = w / 2
	var cy = h / 2

	# Find exit points for each connection
	var exit_points: Array[Vector2i] = []
	for dir_name in connections:
		var ep = RoomShapeGenerator.get_exit_point(floor_mask, w, h, dir_name)
		# Move exit point 2 tiles inward so bridge starts inside the room
		match dir_name:
			"north": ep.y += 2
			"south": ep.y -= 2
			"west": ep.x += 2
			"east": ep.x -= 2
		exit_points.append(ep)

	# Trace paths from each exit to center (1 tile wide)
	for ep in exit_points:
		var path = _bresenham_line(ep.x, ep.y, cx, cy)
		for pos in path:
			if pos.x < 0 or pos.x >= w or pos.y < 0 or pos.y >= h:
				continue
			if not liquid_mask[pos.y][pos.x]:
				continue
			if not web_set.has(pos):
				web_set[pos] = true
				web_positions.append(pos)

	# Add random extra web tiles near existing webs
	var liquid_count = 0
	for y in range(h):
		for x in range(w):
			if liquid_mask[y][x]:
				liquid_count += 1

	var extra_count = int(liquid_count * bridge_density * 0.15)
	var attempts = 0
	while extra_count > 0 and attempts < extra_count * 3:
		attempts += 1
		var x = randi_range(1, w - 2)
		var y = randi_range(1, h - 2)
		if not liquid_mask[y][x]:
			continue
		var v = Vector2i(x, y)
		if web_set.has(v):
			continue
		# Only add if near an existing web
		var near_web = false
		for d in [Vector2i(1,0), Vector2i(-1,0), Vector2i(0,1), Vector2i(0,-1)]:
			if web_set.has(v + d):
				near_web = true
				break
		if near_web:
			web_set[v] = true
			web_positions.append(v)
			extra_count -= 1

	return web_positions

static func _bresenham_line(x0: int, y0: int, x1: int, y1: int) -> Array[Vector2i]:
	var points: Array[Vector2i] = []
	var dx = abs(x1 - x0)
	var dy = abs(y1 - y0)
	var sx = 1 if x0 < x1 else -1
	var sy = 1 if y0 < y1 else -1
	var err = dx - dy

	var x = x0
	var y = y0
	while true:
		points.append(Vector2i(x, y))
		if x == x1 and y == y1:
			break
		var e2 = 2 * err
		if e2 > -dy:
			err -= dy
			x += sx
		if e2 < dx:
			err += dx
			y += sy
	return points
</file>

