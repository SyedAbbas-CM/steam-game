        if not fname.endswith('.tres'):
            continue
        path = os.path.join(zones_dir, fname)
        text = open(path).read()
        m_id = re.search(r'^id = "([^"]*)"', text, re.MULTILINE)
        m_db = re.search(r'^dungeon_base = "([^"]*)"', text, re.MULTILINE)
        if m_id and m_db:
            old_id = m_id.group(1)
            old_dbase = m_db.group(1)
            if old_id in OLD_TO_NEW:
