# ── Buff/Debuff System ────────────────────────────────────

func _apply_buff(id: String, stat: String, value: float, duration: String, timer: float = -1.0) -> void:
	var player = dm.player
	if not player:
		return

	var original: float = 0.0
	var em = player.equipment_manager if player.has_method("get") or "equipment_manager" in player else null
	if not em:
		# Try direct access
		if "equipment_manager" in player:
			em = player.equipment_manager

	match stat:
		"damage_mult":
			original = em.base_stats.damage_mult if em else 1.0
			if em:
				em.base_stats.damage_mult += value
				em.stats_changed.emit()
		"move_speed":
			original = em.base_stats.move_speed if em else 100.0
			if em:
				em.base_stats.move_speed *= (1.0 + value)
				em.stats_changed.emit()
		"max_hp":
			original = float(player.max_hp)
			var bonus = int(original * value)
			player.max_hp += bonus
			player.hp += bonus
			player.hp_changed.emit(player.hp)
		"regen":
			original = 0.0  # no baseline regen
		"gold_mult":
			original = 0.0  # handled in gold pickup logic

	var buff = {
		"id": id, "stat": stat, "value": value, "original": original,
		"duration": duration, "timer": timer,
	}
	_active_buffs.append(buff)

	# Visual tint
	if player:
		if value > 0:
			player.modulate = player.modulate.lerp(Color(0.5, 1.0, 0.5), 0.3)
		elif value < 0:
			player.modulate = player.modulate.lerp(Color(0.7, 0.3, 1.0), 0.3)

func _remove_buff(buff: Dictionary) -> void:
	var player = dm.player
	if not player:
		return

	var em = null
	if "equipment_manager" in player:
		em = player.equipment_manager

	match buff["stat"]:
		"damage_mult":
			if em:
				em.base_stats.damage_mult -= buff["value"]
				em.stats_changed.emit()
		"move_speed":
			if em:
				em.base_stats.move_speed /= (1.0 + buff["value"])
				em.stats_changed.emit()
		"max_hp":
			if buff["duration"] != "permanent":
				var bonus = int(buff["original"] * buff["value"])
				player.max_hp -= bonus
				player.hp = mini(player.hp, player.max_hp)
				player.hp_changed.emit(player.hp)
		"regen", "gold_mult", "poison_tick":
			pass  # No stat to restore

	_active_buffs.erase(buff)

	# Reset tint if no more buffs
	if _active_buffs.size() == 0 and player:
		player.modulate = Color.WHITE

func _remove_buffs_by_duration(duration: String) -> void:
	var to_remove: Array[Dictionary] = []
	for buff in _active_buffs:
		if buff["duration"] == duration:
			to_remove.append(buff)
	for buff in to_remove:
		_remove_buff(buff)

func _tick_timed_buffs(delta: float) -> void:
	var to_remove: Array[Dictionary] = []
	for buff in _active_buffs:
		if buff["duration"] == "timed" and buff["timer"] > 0:
			buff["timer"] -= delta
			if buff["timer"] <= 0:
				to_remove.append(buff)

		# Poison tick
		if buff["stat"] == "poison_tick":
			buff["poison_timer"] = buff.get("poison_timer", 0.0) + delta
			if buff["poison_timer"] >= 3.0:
				buff["poison_timer"] -= 3.0
				if dm.player and dm.player.hp > 1:
					dm.player.hp -= 1
					dm.player.hp_changed.emit(dm.player.hp)

		# Regen tick
		if buff["stat"] == "regen":
			buff["regen_timer"] = buff.get("regen_timer", 0.0) + delta
			if buff["regen_timer"] >= 1.0:
				buff["regen_timer"] -= 1.0
				if dm.player and dm.player.hp < dm.player.max_hp:
					var heal = int(buff["value"])
					dm.player.hp = mini(dm.player.hp + heal, dm.player.max_hp)
					dm.player.hp_changed.emit(dm.player.hp)

	for buff in to_remove:
		_remove_buff(buff)

# ── Helpers ────────────────────────────────────────────────

func _get_hud() -> GameHUD:
	var scene = dm.get_parent()
	if scene and "game_hud" in scene:
		return scene.game_hud
	return null

func get_gold_mult() -> float:
	var mult = 1.0
	for buff in _active_buffs:
		if buff["stat"] == "gold_mult":
			mult += buff["value"]
	return mult
</file>

<file path="scripts/dungeon/liquid_generator.gd">
class_name LiquidGenerator
extends RefCounted

# Returns 2D bool array same dimensions as floor_mask
# true = this tile should be liquid
static func generate_liquid_fill(floor_mask: Array, intensity: float, seed_val: int) -> Array:
	if intensity <= 0.0:
		return _empty_mask(floor_mask)

	var h = floor_mask.size()
	if h == 0:
		return []
	var w = floor_mask[0].size()

	var noise = FastNoiseLite.new()
	noise.seed = seed_val
	noise.frequency = 0.15
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX

	var liquid_mask: Array = []
	for y in range(h):
		var row: Array = []
		for x in range(w):
			if not floor_mask[y][x]:
				row.append(false)
				continue
			var noise_val = (noise.get_noise_2d(float(x), float(y)) + 1.0) / 2.0
			row.append(noise_val < intensity)
		liquid_mask.append(row)

	return liquid_mask

# Directional flow: creates a river/channel pattern flowing in a direction
# flow_direction: Vector2 indicating flow axis (e.g. Vector2(1,0) = east, Vector2(0,1) = south)
static func generate_directional_flow(floor_mask: Array, intensity: float, seed_val: int, flow_direction: Vector2) -> Array:
	if intensity <= 0.0:
		return _empty_mask(floor_mask)

	var h = floor_mask.size()
	if h == 0:
		return []
	var w = floor_mask[0].size()

	var noise = FastNoiseLite.new()
	noise.seed = seed_val
	noise.frequency = 0.12
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX

	# Perpendicular direction for computing distance from flow center-line
	var perp = Vector2(-flow_direction.y, flow_direction.x)
	var cx = w / 2.0
	var cy = h / 2.0
	# Max perpendicular distance from center
	var max_perp = max(w, h) / 2.0

	var liquid_mask: Array = []
	for y in range(h):
		var row: Array = []
		for x in range(w):
			if not floor_mask[y][x]:
				row.append(false)
				continue
			# Perpendicular distance from center-line through room center
			var rel = Vector2(x - cx, y - cy)
			var perp_dist = abs(rel.dot(perp))
			# Gradient: higher probability near center-line
			var gradient = 1.0 - (perp_dist / max_perp) * 0.7
			var noise_val = (noise.get_noise_2d(float(x), float(y)) + 1.0) / 2.0
			var threshold = intensity * gradient + noise_val * 0.25
			row.append(threshold > 0.55)
		liquid_mask.append(row)

	# Ensure a continuous 2-tile-wide channel along the flow center
	var flow_norm = flow_direction.normalized()
	for i in range(max(w, h)):
		var t = float(i) / float(max(w, h))
		# Walk along flow direction through the room
		var px = int(cx + flow_norm.x * (t - 0.5) * w)
		var py = int(cy + flow_norm.y * (t - 0.5) * h)
		for offset in range(-1, 2):
			var nx = px + int(perp.x) * offset
			var ny = py + int(perp.y) * offset
			if nx >= 0 and nx < w and ny >= 0 and ny < h and floor_mask[ny][nx]:
				liquid_mask[ny][nx] = true

	return liquid_mask

static func _empty_mask(floor_mask: Array) -> Array:
	var result: Array = []
	for y in range(floor_mask.size()):
		var row: Array = []
		for _x in range(floor_mask[y].size()):
			row.append(false)
		result.append(row)
	return result
</file>

