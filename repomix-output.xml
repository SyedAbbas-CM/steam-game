		EnemyDefinition.AttackType.ARROW_VOLLEY]
	if atk in _bomb_attacks:
		attack_timer = shoot_interval * 1.0  # full cooldown for bombs
	else:
		attack_timer = shoot_interval * 0.25  # aggressive fire rate for bullet attacks
