		"name": str(big_gold) + " Gold",
		"description": "A big pile of gold",
		"amount": big_gold,
		"rarity": 1
	})

	# Option 3: HP Potions
	var potion_count = 2 + floor_num / 3
	rewards.append({
		"type": "hp_potion",
