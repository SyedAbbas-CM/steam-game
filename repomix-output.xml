class_name StartScreen
extends Control

var _selected_class: String = "warrior"
var _class_buttons: Dictionary = {}  # class_id -> Button

const CLASS_DATA = {
	"warrior": {
		"name": "Warrior",
		"desc": "Sturdy fighter with sword + shield block.\nShift = raise shield, Space = dash.",
		"color": Color(1.0, 0.85, 0.6),
		"hp": 50, "spd": 30, "dmg": "1.5x"
	},
	"mercenary": {
		"name": "Mercenary",
		"desc": "Versatile blade & bow fighter.\nShift = swap sword / short bow.",
		"color": Color(1.0, 0.7, 0.5),
		"hp": 45, "spd": 35, "dmg": "1.2x"
	},
	"ranger": {
		"name": "Ranger",
		"desc": "Swift bow + dagger, distance scaling.\nShift = swap bow / dagger (high crit).",
		"color": Color(0.7, 1.0, 0.7),
		"hp": 40, "spd": 40, "dmg": "1.0x"
	},
	"wizard": {
		"name": "Wizard",
		"desc": "Glass cannon with staff + charged blast.\nSpace = charge blast, high magic.",
		"color": Color(0.7, 0.7, 1.0),
		"hp": 30, "spd": 35, "dmg": "2.0x"
	},
}

func _ready() -> void:
	# Restore last selected class
	if GameManager and GameManager.save_data:
		_selected_class = GameManager.save_data.selected_class
	_build_ui()

func _build_ui() -> void:
	# Background
	var bg = ColorRect.new()
	bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	bg.color = Color(0.03, 0.03, 0.08)
	add_child(bg)

	# Center container
	var center = VBoxContainer.new()
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	center.add_theme_constant_override("separation", 20)
	center.alignment = BoxContainer.ALIGNMENT_CENTER
	add_child(center)

	# Game title
	var title = Label.new()
	title.text = "DUNGEON CRAWL"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	var title_settings = LabelSettings.new()
	title_settings.font_size = 72
	title_settings.font_color = Color(0.9, 0.8, 0.3)
	title_settings.outline_size = 4
	title_settings.outline_color = Color(0.3, 0.2, 0.0)
	title.label_settings = title_settings
	center.add_child(title)

	# Subtitle
	var subtitle = Label.new()
	subtitle.text = "A Roguelike Adventure"
	subtitle.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	var sub_settings = LabelSettings.new()
	sub_settings.font_size = 28
	sub_settings.font_color = Color(0.6, 0.6, 0.7)
	subtitle.label_settings = sub_settings
	center.add_child(subtitle)

	# Spacer
	var spacer = Control.new()
	spacer.custom_minimum_size = Vector2(0, 30)
	center.add_child(spacer)

	# Class label
	var class_label = Label.new()
	class_label.text = "CHOOSE YOUR CLASS"
	class_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	var cl_settings = LabelSettings.new()
	cl_settings.font_size = 24
	cl_settings.font_color = Color(0.8, 0.75, 0.6)
	class_label.label_settings = cl_settings
	center.add_child(class_label)

	# Class buttons in a horizontal row
	var class_row = HBoxContainer.new()
	class_row.alignment = BoxContainer.ALIGNMENT_CENTER
	class_row.add_theme_constant_override("separation", 16)
	class_row.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	center.add_child(class_row)

	for class_id in CLASS_DATA:
		var data = CLASS_DATA[class_id]
		var btn_vbox = _create_class_button(class_id, data)
		class_row.add_child(btn_vbox)

	_update_class_selection()

	# Spacer
	var spacer2 = Control.new()
	spacer2.custom_minimum_size = Vector2(0, 20)
	center.add_child(spacer2)

	# Start button
	var start_btn = Button.new()
	start_btn.text = "Start Game"
	start_btn.custom_minimum_size = Vector2(300, 70)
	start_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	start_btn.add_theme_font_size_override("font_size", 32)
	start_btn.pressed.connect(_on_start)
	center.add_child(start_btn)

	# Stats display
	if GameManager and GameManager.save_data:
		var spacer3 = Control.new()
		spacer3.custom_minimum_size = Vector2(0, 20)
		center.add_child(spacer3)

		var stats = Label.new()
		var sd = GameManager.save_data
		stats.text = "Runs: " + str(sd.total_runs) + "  |  Best Floor: " + str(sd.best_floor) + "  |  Gold: " + str(sd.gold)
		stats.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		var stats_settings = LabelSettings.new()
		stats_settings.font_size = 22
		stats_settings.font_color = Color(0.5, 0.5, 0.5)
		stats.label_settings = stats_settings
		center.add_child(stats)

func _create_class_button(class_id: String, data: Dictionary) -> VBoxContainer:
	var vbox = VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 4)

	var btn = Button.new()
	btn.custom_minimum_size = Vector2(200, 120)
	btn.focus_mode = Control.FOCUS_NONE
	btn.pressed.connect(_on_class_selected.bind(class_id))

	var style = StyleBoxFlat.new()
	style.bg_color = Color(0.08, 0.08, 0.14)
	style.border_color = Color(0.3, 0.3, 0.4)
	style.set_border_width_all(2)
	style.set_corner_radius_all(6)
	style.content_margin_left = 10
	style.content_margin_right = 10
	style.content_margin_top = 8
	style.content_margin_bottom = 8
	btn.add_theme_stylebox_override("normal", style)

	var hover_style = style.duplicate()
	hover_style.bg_color = Color(0.12, 0.12, 0.2)
	hover_style.border_color = data["color"].darkened(0.2)
	btn.add_theme_stylebox_override("hover", hover_style)

	# Button content
	var content = VBoxContainer.new()
	content.mouse_filter = Control.MOUSE_FILTER_IGNORE
	content.add_theme_constant_override("separation", 6)

	var name_lbl = Label.new()
	name_lbl.text = data["name"]
	name_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_lbl.add_theme_font_size_override("font_size", 22)
	name_lbl.add_theme_color_override("font_color", data["color"])
	name_lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	content.add_child(name_lbl)

	var desc_lbl = Label.new()
	desc_lbl.text = data["desc"]
	desc_lbl.add_theme_font_size_override("font_size", 14)
	desc_lbl.add_theme_color_override("font_color", Color(0.7, 0.7, 0.7))
	desc_lbl.autowrap_mode = TextServer.AUTOWRAP_WORD
	desc_lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	content.add_child(desc_lbl)

	var stats_lbl = Label.new()
	stats_lbl.text = "HP:%d SPD:%d DMG:%s" % [data["hp"], data["spd"], data["dmg"]]
	stats_lbl.add_theme_font_size_override("font_size", 13)
	stats_lbl.add_theme_color_override("font_color", Color(0.5, 0.8, 0.5))
	stats_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	stats_lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	content.add_child(stats_lbl)

	btn.add_child(content)
	vbox.add_child(btn)
	_class_buttons[class_id] = btn
	return vbox

func _on_class_selected(class_id: String) -> void:
	_selected_class = class_id
	_update_class_selection()
	var sfx = get_node_or_null("/root/SFXManager")
	if sfx:
		sfx.play("select_a", -4.0, 0.0)

func _update_class_selection() -> void:
	for class_id in _class_buttons:
		var btn = _class_buttons[class_id] as Button
		var style = btn.get_theme_stylebox("normal") as StyleBoxFlat
		if not style:
			continue
		if class_id == _selected_class:
			var data = CLASS_DATA[class_id]
			style.bg_color = data["color"].darkened(0.7)
			style.border_color = data["color"]
			style.set_border_width_all(3)
		else:
			style.bg_color = Color(0.08, 0.08, 0.14)
			style.border_color = Color(0.3, 0.3, 0.4)
			style.set_border_width_all(2)

func _on_start() -> void:
	# Store class selection
	if GameManager:
		GameManager.selected_class = _selected_class
		if GameManager.save_data:
			GameManager.save_data.selected_class = _selected_class
			GameManager.save_data.save_game()

	var sfx = get_node_or_null("/root/SFXManager")
	if sfx:
		sfx.play("select_a", -2.0, 0.0)
	# Show loading feedback
	var loading = Label.new()
	loading.text = "Loading world..."
	loading.set_anchors_preset(Control.PRESET_CENTER)
	loading.add_theme_font_size_override("font_size", 24)
	loading.add_theme_color_override("font_color", Color.WHITE)
	add_child(loading)
	await get_tree().process_frame
	await get_tree().process_frame
	if GameManager:
		GameManager.return_to_overworld()
	else:
		get_tree().change_scene_to_file("res://scenes/overworld/overworld.scn")
</file>

<file path="scripts/ui/touch_controls.gd">
class_name TouchControls
extends CanvasLayer

var left_stick: VirtualJoystick
var right_stick: VirtualJoystick
var _interact_btn: Control
var _sprint_btn: Control  # Shift key — sprint / alt-fire
var _shield_btn: Control  # R key — warrior shield
var _power_btn: Control   # Space key — class powers (charge, paralysis, dash)
var _interact_visible: bool = false
var _sprint_held: bool = false

# Touch tracking per button: action_name -> touch_index
var _btn_touch_map: Dictionary = {}

static func is_mobile() -> bool:
	return OS.get_name() == "Android" or OS.get_name() == "iOS"

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	add_to_group("touch_controls")

	if not TouchControls.is_mobile():
		visible = false

	_build_ui()

func _build_ui() -> void:
	var container = Control.new()
	container.anchors_preset = Control.PRESET_FULL_RECT
	container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(container)

	var vp_size = get_viewport().get_visible_rect().size
	var margin = 30
	var stick_size = 250 # 120 radius * 2 + 10

	# Left joystick - bottom left
	left_stick = VirtualJoystick.new()
	left_stick.position = Vector2(margin, vp_size.y - margin - stick_size)
	container.add_child(left_stick)

	# Right joystick - bottom right
	right_stick = VirtualJoystick.new()
	right_stick.position = Vector2(vp_size.x - margin - stick_size, vp_size.y - margin - stick_size)
	container.add_child(right_stick)

	# --- Interact button (bottom center, hidden by default) ---
	_interact_btn = _make_touch_btn("interact", "Interact", Vector2(280, 100), 34,
		Color(0.1, 0.4, 0.15, 0.85), Color(0.3, 0.9, 0.4))
	_interact_btn.position = Vector2(vp_size.x / 2.0 - 140, vp_size.y - margin - 120)
	_interact_btn.visible = false
	container.add_child(_interact_btn)

	# All action buttons on RIGHT side
	var right_x = vp_size.x - margin - stick_size  # right joystick left edge

	# --- Sprint / Alt-Fire button — maps to Shift — right side, above-left of joystick ---
	_sprint_btn = _make_touch_btn("sprint", "Sprint", Vector2(220, 90), 32,
		Color(0.15, 0.25, 0.5, 0.85), Color(0.3, 0.5, 0.9))
	_sprint_btn.position = Vector2(right_x - 235, vp_size.y - margin - stick_size - 20)
	container.add_child(_sprint_btn)

	# --- Shield button — maps to R, warrior only — right side, above sprint ---
	_shield_btn = _make_touch_btn("shield_raise", "Shield", Vector2(220, 90), 32,
		Color(0.4, 0.2, 0.5, 0.85), Color(0.7, 0.4, 0.9))
	_shield_btn.position = Vector2(right_x - 235, vp_size.y - margin - stick_size - 130)
	_shield_btn.visible = false
	container.add_child(_shield_btn)

	# --- Power button — maps to Space ("dash" action) — right side, above joystick ---
	_power_btn = _make_touch_btn("dash", "Power", Vector2(220, 90), 32,
		Color(0.5, 0.3, 0.1, 0.85), Color(0.9, 0.6, 0.2))
	_power_btn.position = Vector2(right_x + 15, vp_size.y - margin - stick_size - 110)
	container.add_child(_power_btn)

func _make_touch_btn(action_name: String, text: String, min_size: Vector2, font_size: int,
		bg_color: Color, border_color: Color) -> Control:
	var panel = Control.new()
	panel.custom_minimum_size = min_size
	panel.size = min_size
	panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	panel.set_meta("action", action_name)
	panel.set_meta("bg_color", bg_color)
	panel.set_meta("border_color", border_color)

	var bg = ColorRect.new()
	bg.size = min_size
	bg.color = bg_color
	bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	panel.add_child(bg)
	panel.set_meta("bg_rect", bg)

	var label = Label.new()
	label.text = text
	label.add_theme_font_size_override("font_size", font_size)
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.size = min_size
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	panel.add_child(label)
	panel.set_meta("label", label)

	return panel

func _input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		if left_stick and left_stick.owns_touch(event.index):
			return
		if right_stick and right_stick.owns_touch(event.index):
			return
		if event.pressed:
			_check_btn_touch(event.position, event.index)
		else:
			_release_btn_touch(event.index)

func _check_btn_touch(pos: Vector2, index: int) -> void:
	var buttons = [_sprint_btn, _interact_btn, _shield_btn, _power_btn]
	for btn in buttons:
		if btn == null or not btn.visible:
			continue
		if _is_in_btn(pos, btn):
			var action: String = btn.get_meta("action")
			_btn_touch_map[action] = index
			_on_btn_pressed(btn, action)
			get_viewport().set_input_as_handled()
			return

func _release_btn_touch(index: int) -> void:
	for action in _btn_touch_map.keys():
		if _btn_touch_map[action] == index:
			_btn_touch_map.erase(action)
			_on_btn_released(action)
			var btn = _get_btn_for_action(action)
			if btn:
				var bg_rect: ColorRect = btn.get_meta("bg_rect")
				bg_rect.color = btn.get_meta("bg_color")
			get_viewport().set_input_as_handled()
			return

func _is_in_btn(pos: Vector2, btn: Control) -> bool:
	var gp = btn.global_position
	var sz = btn.size
	var pad = 20.0
	return pos.x >= gp.x - pad and pos.x <= gp.x + sz.x + pad \
		and pos.y >= gp.y - pad and pos.y <= gp.y + sz.y + pad

func _get_btn_for_action(action: String) -> Control:
	match action:
		"sprint": return _sprint_btn
		"interact": return _interact_btn
		"shield_raise": return _shield_btn
		"dash": return _power_btn
	return null

func _on_btn_pressed(btn: Control, action: String) -> void:
	var bg_rect: ColorRect = btn.get_meta("bg_rect")
	bg_rect.color = btn.get_meta("bg_color").lightened(0.3)
	Input.action_press(action)
	if action == "sprint":
		_sprint_held = true

func _on_btn_released(action: String) -> void:
	Input.action_release(action)
	if action == "sprint":
		_sprint_held = false

func show_interact_button(text: String = "Interact") -> void:
	if _interact_btn:
		var label: Label = _interact_btn.get_meta("label")
		label.text = text
		_interact_btn.visible = true
		_interact_visible = true

func hide_interact_button() -> void:
	if _interact_btn:
		_interact_btn.visible = false
		_interact_visible = false

func show_shield_button(show: bool) -> void:
	if _shield_btn:
		_shield_btn.visible = show

func set_power_label(text: String) -> void:
	if _power_btn:
		var label: Label = _power_btn.get_meta("label")
		label.text = text

func is_sprinting() -> bool:
	return _sprint_held

func get_move_input() -> Vector2:
	if left_stick:
		return left_stick.get_output()
	return Vector2.ZERO

func get_aim_input() -> Vector2:
	if right_stick:
		return right_stick.get_output()
	return Vector2.ZERO

func is_shooting() -> bool:
	if right_stick:
		return right_stick.is_active() and right_stick.get_output().length() > 0.1
	return false
</file>

<file path="scripts/ui/virtual_joystick.gd">
class_name VirtualJoystick
extends Control

@export var stick_radius: float = 120.0
@export var dead_zone: float = 0.08

var _pressed: bool = false
var _touch_index: int = -1
var _output: Vector2 = Vector2.ZERO

var base_circle: ColorRect
var nub_circle: ColorRect

func get_output() -> Vector2:
	return _output

func is_active() -> bool:
	return _pressed

func _ready() -> void:
	custom_minimum_size = Vector2(stick_radius * 2 + 10, stick_radius * 2 + 10)
	size = custom_minimum_size

	# Base circle (outer ring)
	base_circle = ColorRect.new()
	base_circle.size = Vector2(stick_radius * 2, stick_radius * 2)
	base_circle.position = Vector2(5, 5)
	base_circle.color = Color(1, 1, 1, 0.15)
	add_child(base_circle)

	# Nub (inner circle)
	nub_circle = ColorRect.new()
	nub_circle.size = Vector2(64, 64)
	nub_circle.color = Color(1, 1, 1, 0.4)
	add_child(nub_circle)
	_center_nub()

func _center_nub() -> void:
	nub_circle.position = base_circle.position + Vector2(stick_radius, stick_radius) - nub_circle.size / 2.0

func owns_touch(index: int) -> bool:
	return _pressed and _touch_index == index

func _input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		if event.pressed and _is_in_zone(event.position):
			_pressed = true
			_touch_index = event.index
			_update_nub(event.position)
			get_viewport().set_input_as_handled()
		elif not event.pressed and event.index == _touch_index:
			_reset()
			get_viewport().set_input_as_handled()
	elif event is InputEventScreenDrag:
		if event.index == _touch_index and _pressed:
			_update_nub(event.position)
			get_viewport().set_input_as_handled()

func _is_in_zone(pos: Vector2) -> bool:
	var local = pos - global_position
	return local.x >= -40 and local.x <= size.x + 40 and local.y >= -40 and local.y <= size.y + 40

func _update_nub(screen_pos: Vector2) -> void:
	var center = global_position + base_circle.position + Vector2(stick_radius, stick_radius)
	var local = screen_pos - center
	var clamped = local
	if local.length() > stick_radius:
		clamped = local.normalized() * stick_radius
	nub_circle.position = base_circle.position + Vector2(stick_radius, stick_radius) + clamped - nub_circle.size / 2.0
	_output = clamped / stick_radius
	if _output.length() < dead_zone:
		_output = Vector2.ZERO

func _reset() -> void:
	_pressed = false
	_touch_index = -1
	_output = Vector2.ZERO
	_center_nub()
</file>

<file path="scripts/weapons/patterns/boomerang_pattern.gd">
class_name BoomerangPattern
extends WeaponPattern

## Fires bullets in a wide arc that curves back — like a boomerang throw.
## Uses offset directions that fan out wide then converge.
@export var arc_count: int = 3
@export var arc_spread: float = 0.8  # wide arc angle

func _init() -> void:
	pattern_name = "Boomerang"

func get_fire_data(aim_direction: Vector2, _stats: EquipmentManager) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	if arc_count <= 1:
		result.append({
			"direction": aim_direction,
			"delay": 0.0,
			"offset": Vector2.ZERO,
			"speed_mult": 1.0
		})
		return result

	var start = -arc_spread / 2.0
	var step = arc_spread / (arc_count - 1)
	for i in range(arc_count):
		var angle = start + step * i
		var dir = aim_direction.rotated(angle)
		# Outer bullets are faster, inner slower — creates curving arc
		var t = abs(float(i) - (arc_count - 1) / 2.0) / ((arc_count - 1) / 2.0)
		result.append({
			"direction": dir,
			"delay": 0.0,
			"offset": Vector2.ZERO,
			"speed_mult": 0.7 + t * 0.6,
			"damage_mult": 1.0 / arc_count
		})
	return result
</file>

