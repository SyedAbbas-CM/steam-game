func _load_recipes() -> void:
	_recipes.clear()
	var paths = ResourceRegistry.crafting_recipes()
	for path in paths:
		var recipe = load(path) as CraftingRecipe
		if recipe and recipe.recipe_type == _craft_type:
			_recipes.append(recipe)
	# Sort by level
