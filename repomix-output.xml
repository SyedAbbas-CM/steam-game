	# Staging Grounds area
	"gallows": {"ps": Vector2i(265, 37), "es": Vector2i(321, 39)},
	"wardens": {"ps": Vector2i(265, 37), "es": Vector2i(321, 39)},
	# Farm area
	"duskfarm": {"ps": Vector2i(124, 64), "es": Vector2i(224, 45)},
