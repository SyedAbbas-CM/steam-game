async function openQuest(questId) {
    const data = await fetch(`/api/quest/${questId}`).then(r => r.json());
    document.getElementById('panel-content').innerHTML = `
        <button onclick="switchTab('quests')" style="background:none;border:none;color:#e94560;cursor:pointer;margin-bottom:6px;font-size:12px">Back</button>
        <div class="field"><label>Quest ID</label><input value="${data.id||''}" readonly style="opacity:0.6"></div>
        <div class="field"><label>Title</label><input value="${esc(data.title||'')}" id="q-title"></div>
        <div class="field-row">
            <div class="field"><label>Level</label><input type="number" value="${data.level||0}" id="q-level"></div>
            <div class="field"><label>Location</label><input value="${esc(data.location||'')}" id="q-location"></div>
        </div>
        <div class="field"><label>Summary</label><textarea id="q-summary">${esc(data.summary||'')}</textarea></div>
        <div class="field"><label>Start Script (JSON)</label><textarea id="q-start" style="min-height:100px;font-family:monospace;font-size:10px">${JSON.stringify(data.start_script||[], null, 2)}</textarea></div>
        <div class="field"><label>Events (JSON)</label><textarea id="q-events" style="min-height:80px;font-family:monospace;font-size:10px">${JSON.stringify(data.events||[], null, 2)}</textarea></div>
        <button onclick="saveQuest('${questId}')" style="background:#4ade80;color:#000;border:none;padding:6px 14px;border-radius:4px;cursor:pointer;margin-top:6px;width:100%;font-size:12px">Save Quest</button>
    `;
}

async function saveQuest(questId) {
    const updates = {
        title: document.getElementById('q-title').value,
        level: parseInt(document.getElementById('q-level').value),
        location: document.getElementById('q-location').value,
        summary: document.getElementById('q-summary').value,
    };
    try {
        updates.start_script = JSON.parse(document.getElementById('q-start').value);
        updates.events = JSON.parse(document.getElementById('q-events').value);
    } catch(e) { showToast('JSON error: ' + e.message, true); return; }
    const res = await fetch(`/api/quest/${questId}`, { method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(updates) });
    if (res.ok) showToast('Quest saved!'); else showToast('Error saving quest', true);
}

// ── Data Updates ─────────────────────────────────────────────────────────
function updateField(field, value) {
    if (!selectedZoneFull) return;
    selectedZoneFull[field] = value;
    markUnsaved();
}

function markUnsaved() {
    hasUnsavedChanges = true;
    document.getElementById('status-save').textContent = 'Unsaved changes';
    document.getElementById('status-save').className = 'unsaved';
}

async function saveChanges() {
    if (!selectedZoneFull || !hasUnsavedChanges) { showToast('Nothing to save'); return; }
    const res = await fetch(`/api/zone/${selectedZone}`, {
        method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(selectedZoneFull)
    });
    if (res.ok) {
        hasUnsavedChanges = false;
        document.getElementById('status-save').textContent = 'Saved';
        document.getElementById('status-save').className = '';
        showToast('Zone saved!');
        zones = await fetch('/api/zones').then(r => r.json());
        render();
    } else { showToast('Error saving zone', true); }
}

// ── Snapshot / Diff / Export ─────────────────────────────────────────────
async function takeSnapshot() {
    const res = await fetch('/api/snapshot').then(r => r.json());
    showToast(`Snapshot taken: ${res.count} zones`);
}

async function showDiff() {
    const res = await fetch('/api/diff');
    if (!res.ok) { showToast('Take a snapshot first', true); return; }
    const changes = await res.json();
    const content = document.getElementById('panel-content');
    if (!changes.length) {
        content.innerHTML = '<p style="color:#4ade80;text-align:center;margin-top:40px">No changes since snapshot</p>';
        return;
    }
    let html = `<h3 style="color:#e94560;margin-bottom:8px;font-size:13px">${changes.length} zone(s) changed</h3>`;
    changes.forEach(c => {
        const name = zones.find(z => z.id === c.zone)?.zone_name || c.zone;
        html += `<div style="padding:6px 8px;background:#0d1b2a;border:1px solid #1a4a8a;border-radius:4px;margin-bottom:4px;font-size:12px;cursor:pointer" onclick="selectZone('${c.zone}')">
            <strong>${esc(name)}</strong> <span style="color:#888">(${c.zone})</span><br>
            <span style="color:#fbbf24;font-size:10px">${c.type}: ${(c.fields || []).join(', ')}</span>
        </div>`;
    });
    content.innerHTML = html;
    document.getElementById('panel-title').textContent = 'Diff Results';
    document.getElementById('panel-subtitle').textContent = '';
}

async function exportAll() {
    const res = await fetch('/api/export', { method: 'POST' });
    const data = await res.json();
    if (data.ok) showToast(`Exported ${data.count} zones`);
    else showToast('Export failed', true);
}

// ── Changeset Import / Diff / Cherry-pick ───────────────────────────────
let importedChangeset = null;
let acceptedChanges = {}; // {zone_id: Set of "x,y" keys}

function importChangesetFile() {
    const input = document.getElementById('cs-file-input');
    input.onchange = async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const text = await file.text();
        try {
            const cs = JSON.parse(text);
            const res = await fetch('/api/import-changeset', {
                method: 'POST', headers: {'Content-Type': 'application/json'}, body: text
            });
            const summary = await res.json();
            importedChangeset = cs;
            acceptedChanges = {};
            // Pre-accept all changes
            for (const [zid, changes] of Object.entries(cs.tile_changes || {})) {
                acceptedChanges[zid] = new Set(changes.map(c => `${c[0]},${c[1]}`));
            }
            document.getElementById('btn-clear-cs').style.display = '';
            showToast(`Imported: ${summary.author} — ${summary.tile_change_count} tiles, ${summary.annotation_count} notes`);
            switchTab('changeset');
            render();
        } catch (err) {
            showToast('Invalid changeset: ' + err.message, true);
        }
        input.value = '';
    };
    input.click();
}

async function clearChangeset() {
    importedChangeset = null;
    acceptedChanges = {};
    document.getElementById('btn-clear-cs').style.display = 'none';
    await fetch('/api/clear-changeset', { method: 'POST' });
    showToast('Changeset cleared');
    render();
}

function renderChangesetTab() {
    const content = document.getElementById('panel-content');
    if (!importedChangeset) {
        content.innerHTML = '<p style="color:#666;text-align:center;margin-top:30px">No changeset imported.<br>Click "Import Changeset" to load one.</p>';
        return;
    }

    const cs = importedChangeset;
    const tc = Object.entries(cs.tile_changes || {});
    const an = Object.entries(cs.annotations || {});
    let html = `<div style="background:#0d1b2a;padding:8px;border-radius:4px;margin-bottom:8px;font-size:11px">
        <strong>Author:</strong> ${esc(cs.author || '?')}<br>
        <strong>Time:</strong> ${cs.timestamp || '?'}<br>
        <strong>Tiles:</strong> ${tc.reduce((s,[,v])=>s+v.length,0)} changes in ${tc.length} zones<br>
        <strong>Notes:</strong> ${an.reduce((s,[,v])=>s+v.length,0)} annotations
    </div>`;

    // Tile changes per zone
    if (tc.length) {
        html += '<h4 style="font-size:11px;color:#e94560;margin-bottom:4px">Tile Changes</h4>';
        for (const [zid, changes] of tc) {
            const zname = zones.find(z => z.id === zid)?.zone_name || zid;
            const accepted = acceptedChanges[zid] || new Set();
            const allAccepted = changes.every(c => accepted.has(`${c[0]},${c[1]}`));
            html += `<div style="background:#0d1b2a;border:1px solid #1a4a8a;border-radius:4px;padding:6px 8px;margin-bottom:4px">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px">
                    <input type="checkbox" ${allAccepted?'checked':''} onchange="toggleZoneChanges('${zid}',this.checked)">
                    <strong style="font-size:11px;flex:1;cursor:pointer" onclick="selectZone('${zid}')">${esc(zname)}</strong>
                    <span style="color:#888;font-size:10px">${changes.length} tiles</span>
                </div>
                <div style="max-height:80px;overflow-y:auto;font-size:10px;color:#aaa">
                    ${changes.slice(0, 20).map(c => {
                        const key = `${c[0]},${c[1]}`;
                        const isAcc = accepted.has(key);
                        return `<label style="display:flex;gap:4px;align-items:center;padding:1px 0;cursor:pointer">
                            <input type="checkbox" ${isAcc?'checked':''} onchange="toggleTileChange('${zid}',${c[0]},${c[1]},this.checked)" style="margin:0">
                            (${c[0]},${c[1]}): ${c[2]} -> ${c[3]}
                        </label>`;
                    }).join('')}
                    ${changes.length > 20 ? `<div style="color:#888">...and ${changes.length-20} more</div>` : ''}
                </div>
            </div>`;
        }
    }

    // Annotations
    if (an.length) {
        html += '<h4 style="font-size:11px;color:#4ade80;margin:8px 0 4px">Annotations</h4>';
        for (const [zid, anns] of an) {
            const zname = zones.find(z => z.id === zid)?.zone_name || zid;
            html += `<div style="background:#0d1b2a;border:1px solid #1a4a8a;border-radius:4px;padding:6px 8px;margin-bottom:4px">
                <strong style="font-size:11px;cursor:pointer" onclick="selectZone('${zid}')">${esc(zname)}</strong>
                ${anns.map(a => `<div style="font-size:10px;color:#4ade80;padding:2px 0">(${a.x},${a.y}): ${esc(a.text)}</div>`).join('')}
            </div>`;
        }
    }

    html += `<button onclick="applyAccepted()" style="background:#4ade80;color:#000;border:none;padding:8px;border-radius:4px;cursor:pointer;width:100%;margin-top:8px;font-size:12px;font-weight:600">Apply Accepted Changes</button>`;
    content.innerHTML = html;
}

function toggleZoneChanges(zid, checked) {
    if (!importedChangeset) return;
    const changes = importedChangeset.tile_changes[zid] || [];
    if (checked) {
        acceptedChanges[zid] = new Set(changes.map(c => `${c[0]},${c[1]}`));
    } else {
        acceptedChanges[zid] = new Set();
    }
    renderChangesetTab();
    render();
}

function toggleTileChange(zid, x, y, checked) {
    if (!acceptedChanges[zid]) acceptedChanges[zid] = new Set();
    const key = `${x},${y}`;
    if (checked) acceptedChanges[zid].add(key);
    else acceptedChanges[zid].delete(key);
    render();
}

async function applyAccepted() {
    const payload = {};
    for (const [zid, keys] of Object.entries(acceptedChanges)) {
        if (!keys.size) continue;
        const changes = (importedChangeset.tile_changes[zid] || []).filter(c => keys.has(`${c[0]},${c[1]}`));
        if (changes.length) payload[zid] = changes;
    }
    if (!Object.keys(payload).length) { showToast('No changes accepted', true); return; }
    const res = await fetch('/api/apply-changes', {
        method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (data.ok) {
        const total = Object.values(payload).reduce((s,v) => s + v.length, 0);
        showToast(`Applied ${total} tile changes to ${data.zones_updated} zones`);
        clearChangeset();
    } else { showToast('Error applying changes', true); }
}

// Draw changeset diff overlay on zones
function drawChangesetOverlay() {
    if (!importedChangeset) return;
    ctx.save();
    for (const [zid, changes] of Object.entries(importedChangeset.tile_changes || {})) {
        const z = zones.find(z => z.id === zid);
        if (!z) continue;
        const off = z.baked_offset || {x:0,y:0};
        const s = z.baked_scale || 1;
        const accepted = acceptedChanges[zid] || new Set();
        for (const [x, y, oldIdx, newIdx] of changes) {
            const px = (off.x + x * s) * TILE_PX;
            const py = (off.y + y * s) * TILE_PX;
            const pw = s * TILE_PX, ph = s * TILE_PX;
            const key = `${x},${y}`;
            ctx.globalAlpha = 0.4;
            ctx.fillStyle = accepted.has(key) ? '#4ade80' : '#ef4444';
            ctx.fillRect(px, py, pw, ph);
        }
    }
    // Annotations
    for (const [zid, anns] of Object.entries(importedChangeset.annotations || {})) {
        const z = zones.find(z => z.id === zid);
        if (!z) continue;
        const off = z.baked_offset || {x:0,y:0};
        const s = z.baked_scale || 1;
        for (const ann of anns) {
            const px = (off.x + ann.x * s) * TILE_PX;
            const py = (off.y + ann.y * s) * TILE_PX;
            const fs = Math.max(6/zoom, Math.min(11/zoom, 200));
            const pad = 3/zoom;
            ctx.globalAlpha = 0.9;
            ctx.fillStyle = '#4ade80';
            ctx.beginPath(); ctx.arc(px, py, 5/zoom, 0, Math.PI*2); ctx.fill();
            ctx.font = `${fs}px sans-serif`;
            const tm = ctx.measureText(ann.text);
            ctx.fillStyle = 'rgba(74,222,128,0.9)';
            ctx.beginPath(); ctx.roundRect(px + 6/zoom, py - fs - pad*2, tm.width + pad*2, fs + pad*2, pad); ctx.fill();
            ctx.fillStyle = '#000'; ctx.textAlign = 'left'; ctx.textBaseline = 'top';
            ctx.fillText(ann.text, px + 6/zoom + pad, py - fs - pad);
        }
    }
    ctx.restore();
}

// ── Utilities ────────────────────────────────────────────────────────────
function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function toggleConnections() { showConnections = !showConnections; document.getElementById('btn-connections').classList.toggle('active', showConnections); render(); }
function toggleLabels() { showLabels = !showLabels; document.getElementById('btn-labels').classList.toggle('active', showLabels); render(); }
function filterZones(query) { searchFilter = query.toLowerCase(); render(); }

function showToast(msg, isError) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.background = isError ? '#e94560' : '#4ade80';
    t.style.color = isError ? '#fff' : '#000';
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2500);
}

// Keyboard shortcuts
document.addEventListener('keydown', e => {
    if (e.ctrlKey && e.key === 's') { e.preventDefault(); saveChanges(); }
    if (e.key === 'Escape') { selectedZone = null; selectedZoneFull = null; switchTab(currentTab); render(); }
});

// Start
init();
</script>
</body>
</html>
</file>

<file path="scripts/ui/army_management_screen.gd">
class_name ArmyManagementScreen
extends CanvasLayer

## Army management UI with 4 tabs: ARMY overview, DIVISIONS, RECRUIT, UPGRADES.
## Opened from the War Table interactable in Aria.

signal closed

const HIRE_COSTS := {
	"infantry": 80,
	"archer": 120,
	"heavy_infantry": 180,
	"cavalry": 250,
	"mage": 220,
	"heavy_cavalry": 400,
	"spear": 130,
	"horse_archer": 300,
	"ranged_infantry": 160,
}
const UNIT_NAMES := {
	"infantry": "Infantry",
	"archer": "Archer",
	"heavy_infantry": "Heavy Infantry",
	"cavalry": "Cavalry",
	"mage": "Mage",
	"heavy_cavalry": "Heavy Cavalry",
	"spear": "Spear Infantry",
	"horse_archer": "Horse Archer",
	"ranged_infantry": "Ranged Infantry",
}
const UNIT_ORDER := ["infantry", "heavy_infantry", "spear", "archer", "ranged_infantry", "cavalry", "heavy_cavalry", "horse_archer", "mage"]
const MAX_HIRED := 300

var _panel: PanelContainer
var _tab_container: Control
var _tab_buttons: Array[Button] = []
var _tab_pages: Array[Control] = []
var _current_tab: int = 0

# Recruit tab widgets
var _recruit_rows: Dictionary = {}
var _gold_label: Label
var _recruit_total_label: Label

# Upgrade tab widgets
var _upgrade_rows: Dictionary = {}
var _tokens_label: Label

# Army tab widgets
var _army_info_label: Label

# Division tab widgets
var _div_list_container: VBoxContainer
var _div_edit_panel: Control
var _div_name_edit: LineEdit
var _div_unit_rows: Dictionary = {}
var _div_available_label: Label
var _editing_div_index: int = -1  # -1 = creating new

func _ready() -> void:
	layer = 90
	process_mode = Node.PROCESS_MODE_ALWAYS
	add_to_group("army_management")

	# Overlay
	var overlay := ColorRect.new()
	overlay.color = Color(0, 0, 0, 0.6)
	overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	add_child(overlay)

	# Main panel
	_panel = PanelContainer.new()
	_panel.custom_minimum_size = Vector2(800, 600)
	_panel.position = Vector2((1920 - 800) / 2.0, (1080 - 600) / 2.0)
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.08, 0.06, 0.14, 0.95)
	style.border_color = Color(0.5, 0.4, 0.2)
	style.set_border_width_all(2)
	style.set_corner_radius_all(8)
	style.set_content_margin_all(16)
	_panel.add_theme_stylebox_override("panel", style)
	add_child(_panel)

	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 8)
	_panel.add_child(vbox)

	# Title
	var title := Label.new()
	title.text = "WAR TABLE"
	title.add_theme_font_size_override("font_size", 24)
	title.add_theme_color_override("font_color", Color(0.9, 0.8, 0.5))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	vbox.add_child(title)

	# Tab bar
	var tab_bar := HBoxContainer.new()
	tab_bar.add_theme_constant_override("separation", 4)
	vbox.add_child(tab_bar)
	var tab_names: Array[String] = ["ARMY", "DIVISIONS", "RECRUIT", "UPGRADES"]
	for i in 4:
		var tab_name: String = tab_names[i]
		var btn := Button.new()
		btn.text = tab_name
		btn.add_theme_font_size_override("font_size", 16)
		btn.focus_mode = Control.FOCUS_NONE
		btn.pressed.connect(_switch_tab.bind(i))
		tab_bar.add_child(btn)
		_tab_buttons.append(btn)

	# Separator
	var sep := HSeparator.new()
	vbox.add_child(sep)

	# Tab container
	_tab_container = Control.new()
	_tab_container.custom_minimum_size = Vector2(760, 460)
	_tab_container.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_child(_tab_container)

	_build_army_tab()
	_build_divisions_tab()
	_build_recruit_tab()
	_build_upgrades_tab()

	# Close button
	var close_btn := Button.new()
	close_btn.text = "Close [ESC]"
	close_btn.add_theme_font_size_override("font_size", 14)
	close_btn.focus_mode = Control.FOCUS_NONE
	close_btn.pressed.connect(_close)
	vbox.add_child(close_btn)

	_switch_tab(0)

func _input(event: InputEvent) -> void:
	if event.is_action_pressed("ui_cancel"):
		_close()
		get_viewport().set_input_as_handled()

func _close() -> void:
	var sfx = get_node_or_null("/root/SFXManager")
	if sfx:
		sfx.play("close", -5.0)
	closed.emit()
	queue_free()

func _switch_tab(index: int) -> void:
	_current_tab = index
	for i in _tab_pages.size():
		_tab_pages[i].visible = (i == index)
	for i in _tab_buttons.size():
		_tab_buttons[i].modulate = Color.WHITE if i == index else Color(0.6, 0.6, 0.6)
	if index == 0:
		_refresh_army_tab()
	elif index == 1:
		_refresh_divisions_tab()
	elif index == 2:
		_refresh_recruit_tab()
	elif index == 3:
		_refresh_upgrades_tab()

# ==================== ARMY TAB ====================

func _build_army_tab() -> void:
	var page := VBoxContainer.new()
	page.add_theme_constant_override("separation", 6)
	_tab_container.add_child(page)
	_tab_pages.append(page)

	_army_info_label = Label.new()
	_army_info_label.add_theme_font_size_override("font_size", 15)
	_army_info_label.add_theme_color_override("font_color", Color(0.8, 0.8, 0.8))
	_army_info_label.autowrap_mode = TextServer.AUTOWRAP_WORD
	_army_info_label.custom_minimum_size = Vector2(740, 0)
	_army_info_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	page.add_child(_army_info_label)

func _refresh_army_tab() -> void:
	var gm = get_node_or_null("/root/GameManager")
	if not gm or not gm.save_data:
		_army_info_label.text = "No save data."
		return

	var level: int = gm.save_data.player_level
	var militia := maxi(30, level * 5 + 15)
	var hired := _get_hired()
	var total_hired := 0
	var lines := "=== YOUR ARMY ===\n\n"
	lines += "Militia (Infantry): %d  (level %d)\n\n" % [militia, level]
	lines += "--- Hired Fighters ---\n"
	for type_name in UNIT_ORDER:
		var count: int = int(hired.get(type_name, 0))
		total_hired += count
		if count > 0:
			lines += "  %s: %d\n" % [UNIT_NAMES[type_name], count]
	if total_hired == 0:
		lines += "  (none)\n"
	lines += "\nTotal Army Strength: %d" % (militia + total_hired)
	lines += "\nTroop Tokens: %d" % gm.save_data.troop_tokens

	# Veteran summary
	var veterans: Dictionary = gm.save_data.army_state.get("veterans", {})
	if not veterans.is_empty():
		lines += "\n\n--- Veterans ---"
		for type_name in UNIT_ORDER:
			if veterans.has(type_name):
				var vet_data: Dictionary = veterans[type_name]
				var parts: Array[String] = []
				for rank in ["elite", "veteran", "trained"]:
					var n: int = vet_data.get(rank, 0)
					if n > 0:
						parts.append("%d %s" % [n, rank])
				if not parts.is_empty():
					lines += "\n  %s: %s" % [UNIT_NAMES[type_name], ", ".join(parts)]

	# Division summary
	var divs: Array = gm.save_data.army_divisions
	if not divs.is_empty():
		lines += "\n\n--- Divisions ---\n"
		for div in divs:
			var div_total := 0
			for u in div.get("units", []):
				div_total += int(u.get("count", 0))
			lines += "  %s: %d units\n" % [div.get("name", "?"), div_total]

	_army_info_label.text = lines

# ==================== DIVISIONS TAB ====================

func _build_divisions_tab() -> void:
	var page := HBoxContainer.new()
	page.add_theme_constant_override("separation", 12)
	_tab_container.add_child(page)
	_tab_pages.append(page)

	# Left: division list
	var left := VBoxContainer.new()
	left.custom_minimum_size = Vector2(200, 0)
	left.add_theme_constant_override("separation", 4)
	page.add_child(left)

	var list_title := Label.new()
	list_title.text = "Divisions"
	list_title.add_theme_font_size_override("font_size", 18)
	list_title.add_theme_color_override("font_color", Color(0.9, 0.8, 0.5))
	left.add_child(list_title)

	_div_list_container = VBoxContainer.new()
	_div_list_container.add_theme_constant_override("separation", 2)
	left.add_child(_div_list_container)

	var create_btn := Button.new()
	create_btn.text = "+ Create Division"
	create_btn.add_theme_font_size_override("font_size", 14)
	create_btn.focus_mode = Control.FOCUS_NONE
	create_btn.pressed.connect(_on_create_division)
	left.add_child(create_btn)

	# Right: edit panel
	_div_edit_panel = VBoxContainer.new()
	_div_edit_panel.custom_minimum_size = Vector2(320, 0)
	_div_edit_panel.add_theme_constant_override("separation", 6)
	_div_edit_panel.visible = false
	page.add_child(_div_edit_panel)

	# Division name
	var name_row := HBoxContainer.new()
	_div_edit_panel.add_child(name_row)
	var name_lbl := Label.new()
	name_lbl.text = "Name: "
	name_lbl.add_theme_font_size_override("font_size", 16)
	name_row.add_child(name_lbl)
	_div_name_edit = LineEdit.new()
	_div_name_edit.custom_minimum_size = Vector2(200, 0)
	_div_name_edit.placeholder_text = "Division name"
	name_row.add_child(_div_name_edit)

	# Unit type rows with +/- buttons and bulk buttons
	for type_name in UNIT_ORDER:
		var row := HBoxContainer.new()
		row.add_theme_constant_override("separation", 4)
		_div_edit_panel.add_child(row)

		var lbl := Label.new()
		lbl.text = UNIT_NAMES[type_name]
		lbl.custom_minimum_size = Vector2(110, 0)
		lbl.add_theme_font_size_override("font_size", 14)
		row.add_child(lbl)

		var minus_btn := Button.new()
		minus_btn.text = "-"
		minus_btn.custom_minimum_size = Vector2(28, 28)
		minus_btn.focus_mode = Control.FOCUS_NONE
		minus_btn.pressed.connect(_div_adjust.bind(type_name, -1))
		row.add_child(minus_btn)

		var count_lbl := Label.new()
		count_lbl.text = "0"
		count_lbl.custom_minimum_size = Vector2(30, 0)
		count_lbl.add_theme_font_size_override("font_size", 14)
		count_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		row.add_child(count_lbl)

		var plus_btn := Button.new()
		plus_btn.text = "+"
		plus_btn.custom_minimum_size = Vector2(28, 28)
		plus_btn.focus_mode = Control.FOCUS_NONE
		plus_btn.pressed.connect(_div_adjust.bind(type_name, 1))
		row.add_child(plus_btn)

		var p5_btn := Button.new()
		p5_btn.text = "+5"
		p5_btn.custom_minimum_size = Vector2(34, 28)
		p5_btn.add_theme_font_size_override("font_size", 12)
		p5_btn.focus_mode = Control.FOCUS_NONE
		p5_btn.pressed.connect(_div_adjust.bind(type_name, 5))
		row.add_child(p5_btn)

		var p10_btn := Button.new()
		p10_btn.text = "+10"
		p10_btn.custom_minimum_size = Vector2(38, 28)
		p10_btn.add_theme_font_size_override("font_size", 12)
		p10_btn.focus_mode = Control.FOCUS_NONE
		p10_btn.pressed.connect(_div_adjust.bind(type_name, 10))
		row.add_child(p10_btn)

		var all_btn := Button.new()
		all_btn.text = "ALL"
		all_btn.custom_minimum_size = Vector2(38, 28)
		all_btn.add_theme_font_size_override("font_size", 12)
		all_btn.focus_mode = Control.FOCUS_NONE
		all_btn.pressed.connect(_div_adjust_all.bind(type_name))
		row.add_child(all_btn)

		_div_unit_rows[type_name] = {"count_label": count_lbl}

	_div_available_label = Label.new()
