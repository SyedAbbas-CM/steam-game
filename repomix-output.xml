<script>
/*__WORLD_DATA__*/

// ── State ────────────────────────────────────────────────────────────────
let zones = [];       // flat list for rendering
let zonesMap = {};    // id -> zone data (with grids)
let quests = [];
let selectedZone = null;
let currentTab = 'palette';
let showLabels = true;
let showNpcs = true;
let showQuests = true;
let searchFilter = '';

// Quest-to-zone lookup (built in init)
let questsByZone = {};

// Canvas
const canvas = document.getElementById('map');
const ctx = canvas.getContext('2d');
let camX = 0, camY = 0, zoom = 1.0;
let isDragging = false, dragStartX = 0, dragStartY = 0, dragStartCamX = 0, dragStartCamY = 0, didDrag = false;

// Tile rendering
const TILE_PX = 32;
const ATLAS_COLS = 16;
let maptilesImg = null, maptilesLoaded = false;
let charsImg = null, chars2Img = null;
const tileCache = {}; // zone_id -> offscreen canvas (for painting)
const terrainChunks = {}; // "cx,cy" -> offscreen canvas (Godot terrain)
const TERRAIN_CHUNK = 64; // tiles per chunk side
let terrainData = null; // decoded terrain grid
let terrainReady = false;

// Spritesheet system: multiple atlases
// Tile index encoding: sheetOffset + localIdx
// maptiles: 0-255, tiles: 256-511, tiles2: 512-767, lofiEnv: 768-1183 (16x26=416), dungeonFeat: 1184-1291 (12x9=108)
const SHEETS = [
    { id: 'maptiles', name: 'Overworld (maptiles)', file: 'maptiles.png', cols: 16, rows: 16, tilePx: 32, offset: 0, img: null },
    { id: 'tiles', name: 'LoY Tiles', file: 'tiles.png', cols: 16, rows: 16, tilePx: 32, offset: 256, img: null },
    { id: 'tiles2', name: 'LoY Tiles 2', file: 'tiles2.png', cols: 16, rows: 16, tilePx: 32, offset: 512, img: null },
    { id: 'lofiEnv', name: 'Dungeon Env (8px)', file: 'lofiEnvironment.png', cols: 16, rows: 26, tilePx: 8, offset: 768, img: null },
    { id: 'dungeonFeat', name: 'Dungeon Features (8px)', file: 'lofi_dungeon_features.png', cols: 12, rows: 9, tilePx: 8, offset: 1184, img: null },
    { id: 'lofiObj', name: 'LoFi Objects (8px)', file: 'lofi_obj.png', cols: 16, rows: 16, tilePx: 8, offset: 1292, img: null },
    { id: 'lofiObjB', name: 'LoFi Objects B (8px)', file: 'lofi_obj_packB.png', cols: 9, rows: 8, tilePx: 8, offset: 1548, img: null },
];
let selectedSheet = SHEETS[0]; // currently active spritesheet
let allSheetsLoaded = false;

function getSheetForIdx(idx) {
    for (let i = SHEETS.length - 1; i >= 0; i--) {
        if (idx >= SHEETS[i].offset) return SHEETS[i];
    }
    return SHEETS[0];
}

function getSheetLocalIdx(globalIdx) {
    const sheet = getSheetForIdx(globalIdx);
    return { sheet, localIdx: globalIdx - sheet.offset };
}

// Get effective tile at key for the active layer
function getLayerTile(key) {
    const paintLayer = layerPaints[activeLayer];
    let v = paintLayer[key];
    if (v !== undefined) return v;
    // For ground layer, fall through to base terrain
    if (activeLayer === 'ground') {
        if (terrainOverlay && terrainOverlay[key] !== undefined) return terrainOverlay[key];
        if (terrainGround && terrainGround[key] !== undefined) return terrainGround[key];
    }
    return -1;
}

function drawTileFromIdx(targetCtx, globalIdx, dx, dy, size) {
    if (globalIdx < 0) { targetCtx.fillStyle = '#0a0a12'; targetCtx.fillRect(dx, dy, size, size); return; }
    const { sheet, localIdx } = getSheetLocalIdx(globalIdx);
    if (!sheet.img) return;
    const sx = (localIdx % sheet.cols) * sheet.tilePx;
    const sy = Math.floor(localIdx / sheet.cols) * sheet.tilePx;
    targetCtx.drawImage(sheet.img, sx, sy, sheet.tilePx, sheet.tilePx, dx, dy, size, size);
}

