let showLayerTint = false;
const LAYER_COLORS = {
    ground: 'rgba(74,222,128,0.25)',   // green
    paths: 'rgba(251,191,36,0.3)',     // yellow
    buildings: 'rgba(239,68,68,0.3)',  // red
