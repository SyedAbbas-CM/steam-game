const RARITY_COLORS = [
	Color(0.7, 0.7, 0.7),   # common
	Color(0.3, 0.9, 0.3),   # uncommon
	Color(0.3, 0.8, 1.0),   # rare
]
const RARITY_NAMES = ["Common", "Uncommon", "Rare"]
const TIER_COLORS = [
	Color(0.6, 0.6, 0.6),   # T0 grey
	Color(0.5, 0.8, 0.4),   # T1 green
	Color(0.3, 0.7, 1.0),   # T2 blue
	Color(0.7, 0.4, 1.0),   # T3 purple
	Color(1.0, 0.6, 0.2),   # T4 orange
	Color(1.0, 0.85, 0.2),  # T5 gold
]

## Compute item power (total flat_bonus across all modifiers)
static func _get_item_power(item: EquipmentItem) -> float:
	var power: float = 0.0
	for mod in item.modifiers:
		power += absf(mod.flat_bonus)
		power += absf(mod.percent_bonus) * 20.0  # weight % bonuses
	if item.heal_hp > 0:
		power += item.heal_hp * 0.5
	if item.heal_mp > 0:
		power += item.heal_mp * 0.3
	return power

## Compute tier from weapon damage or total power
static func _get_item_tier(item: EquipmentItem) -> int:
	# For weapons: tier based on attack damage flat_bonus
	if EquipmentItem.is_weapon_slot(item.slot_type):
		var dmg: float = 0.0
		for mod in item.modifiers:
			if mod.stat == StatModifier.StatType.ATTACK_DAMAGE:
				dmg += mod.flat_bonus
		if dmg >= 30: return 5
		if dmg >= 20: return 4
		if dmg >= 14: return 3
		if dmg >= 7: return 2
		if dmg >= 3: return 1
		return 0
	# For armor/accessories: tier based on total power
	var power = _get_item_power(item)
	if power >= 25: return 5
	if power >= 16: return 4
	if power >= 10: return 3
	if power >= 5: return 2
	if power >= 2: return 1
	return 0

func _ready() -> void:
	layer = 100
	process_mode = Node.PROCESS_MODE_ALWAYS
