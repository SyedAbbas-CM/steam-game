		var spd = randf_range(speed_range.x, speed_range.y)
		result.append({
			"direction": aim_direction.rotated(angle_offset),
			"delay": randf_range(0.0, 0.08),
			"offset": Vector2.ZERO,
			"speed_mult": spd,
			"damage_mult": per_bullet_mult
		})
	return result
