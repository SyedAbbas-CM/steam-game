// ── Mouse handling ───────────────────────────────────────────────────────
const wrap = document.getElementById('canvas-wrap');

function screenToWorld(e) {
    const rect = canvas.getBoundingClientRect();
    const wx = (e.clientX - rect.left - camX) / (zoom * TILE_PX);
    const wy = (e.clientY - rect.top - camY) / (zoom * TILE_PX);
    return {wx, wy};
}

function worldToZoneTile(wx, wy) {
    for (const z of zones) {
        const off = z.baked_offset || {x:0,y:0};
        const s = z.baked_scale || 1;
        const w = (z.width||25)*s, h = (z.height||25)*s;
        if (wx >= off.x && wx < off.x+w && wy >= off.y && wy < off.y+h) {
            const lx = Math.floor((wx - off.x) / s);
            const ly = Math.floor((wy - off.y) / s);
            if (lx >= 0 && lx < (z.width||25) && ly >= 0 && ly < (z.height||25)) {
                return { zoneId: z.id, x: lx, y: ly, zone: z };
            }
        }
    }
    return null;
}

canvas.addEventListener('pointerdown', e => {
    // Right-click or middle-click: always pan (any mode)
    if (e.button === 1 || e.button === 2) {
        isDragging = true; didDrag = false;
        dragStartX = e.clientX; dragStartY = e.clientY;
        dragStartCamX = camX; dragStartCamY = camY;
        wrap.classList.add('dragging');
        canvas.setPointerCapture(e.pointerId);
        return;
    }
    if (e.button !== 0) return;

    // NPC click/drag — in pan mode always, in other modes only with Shift
    if (showNpcs && (mode === 'pan' || e.shiftKey)) {
        const {wx, wy} = screenToWorld(e);
        const hitNpc = findNpcAt(wx, wy);
        if (hitNpc) {
            draggingNpc = hitNpc;
            _npcClickStart = { x: e.clientX, y: e.clientY };
            canvas.setPointerCapture(e.pointerId);
            return;
        }
    }

    // Spawn drag — click near existing spawn in pan mode to drag it
    if (playerSpawn && mode === 'pan') {
        const {wx, wy} = screenToWorld(e);
        const dx = Math.abs(wx - playerSpawn.x - 0.5), dy = Math.abs(wy - playerSpawn.y - 0.5);
        if (dx < Math.max(1.5, 3/zoom) && dy < Math.max(1.5, 3/zoom)) {
            draggingSpawn = true;
            canvas.setPointerCapture(e.pointerId);
            return;
        }
    }

    // Spawn placement mode
    if (placingSpawn) {
        const {wx, wy} = screenToWorld(e);
        playerSpawn = { x: Math.floor(wx), y: Math.floor(wy) };
        placingSpawn = false;
        document.getElementById('btn-spawn').classList.remove('active');
        saveAnnotations();
        showToast(`Player spawn set to (${playerSpawn.x}, ${playerSpawn.y})`);
        render();
        return;
    }

    // Area creation works in ANY mode when toggled on
    if (areaCreationMode) {
        const {wx, wy} = screenToWorld(e);
        const tx = Math.floor(wx), ty = Math.floor(wy);
        areaDrawStart = { wx: tx, wy: ty };
        boxCurrent = { wx: tx, wy: ty };
        isPainting = true;
        canvas.setPointerCapture(e.pointerId);
        return;
    }

    if (mode === 'pan') {
        isDragging = true; didDrag = false;
        dragStartX = e.clientX; dragStartY = e.clientY;
        dragStartCamX = camX; dragStartCamY = camY;
        wrap.classList.add('dragging');
        canvas.setPointerCapture(e.pointerId);
    } else if (mode === 'eyedropper' || (mode === 'paint' && e.altKey)) {
        const {wx, wy} = screenToWorld(e);
        eyedropAt(wx, wy);
        return;
    } else if (mode === 'paint' && areaCreationMode) {
        const {wx, wy} = screenToWorld(e);
        const tx = Math.floor(wx), ty = Math.floor(wy);
        areaDrawStart = { wx: tx, wy: ty };
        boxCurrent = { wx: tx, wy: ty };
        isPainting = true;
        canvas.setPointerCapture(e.pointerId);
    } else if (mode === 'paint' && boxSelectMode) {
        const {wx, wy} = screenToWorld(e);
        const tx = Math.floor(wx), ty = Math.floor(wy);
        // If clicking inside existing selection, start dragging it
        if (selection && selectionTiles && tx >= selection.x1 && tx <= selection.x2 && ty >= selection.y1 && ty <= selection.y2) {
            selectionDragging = true;
            selectionDragOff = { dx: tx - selection.x1, dy: ty - selection.y1 };
            selectionDragOrigin = { x1: selection.x1, y1: selection.y1, x2: selection.x2, y2: selection.y2 };
            canvas.setPointerCapture(e.pointerId);
        } else {
            selectionStart = { wx: tx, wy: ty };
            boxCurrent = { wx: tx, wy: ty };
            selection = null; selectionTiles = null;
            isPainting = true;
            canvas.setPointerCapture(e.pointerId);
        }
    } else if (mode === 'paint') {
        const {wx, wy} = screenToWorld(e);
        boxStart = { wx: Math.floor(wx), wy: Math.floor(wy) };
        boxCurrent = { ...boxStart };
        isPainting = true;
        canvas.setPointerCapture(e.pointerId);
    } else if (mode === 'annotate') {
        const {wx, wy} = screenToWorld(e);
        startAnnotation(wx, wy, e.clientX, e.clientY);
    }
});

canvas.addEventListener('pointermove', e => {
    const {wx, wy} = screenToWorld(e);
    document.getElementById('status-mouse').textContent = `Tile: ${Math.floor(wx)},${Math.floor(wy)}`;

    if (draggingSpawn) {
        playerSpawn = { x: Math.floor(wx), y: Math.floor(wy) };
        render();
        return;
    }
    if (draggingNpc) {
        // Move NPC to current world-tile pos (1:1, no scale snapping)
        const z = zonesMap[draggingNpc.zoneId];
        if (z) {
            const off = z.baked_offset || {x:0,y:0};
            const s = z.baked_scale || 1;
            // Store as fractional local coords — snaps to world tiles (not zone-local tiles)
            const worldTileX = Math.floor(wx);
            const worldTileY = Math.floor(wy);
            const localX = (worldTileX - off.x) / s;
            const localY = (worldTileY - off.y) / s;
            const key = draggingNpc.zoneId + '_' + draggingNpc.idx;
            npcMoves[key] = { x: localX, y: localY };
        }
        render();
        return;
    } else if (areaCreationMode && isPainting && areaDrawStart) {
        boxCurrent = { wx: Math.floor(wx), wy: Math.floor(wy) };
        render();
    } else if (isDragging) {
        const dx = e.clientX - dragStartX, dy = e.clientY - dragStartY;
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) didDrag = true;
        camX = dragStartCamX + dx; camY = dragStartCamY + dy;
        render();
    } else if (selectionDragging && selection && selectionTiles) {
        const tx = Math.floor(wx), ty = Math.floor(wy);
        const newX1 = tx - selectionDragOff.dx;
        const newY1 = ty - selectionDragOff.dy;
        const w = selection.x2 - selection.x1;
        const h = selection.y2 - selection.y1;
        selection = { x1: newX1, y1: newY1, x2: newX1 + w, y2: newY1 + h };
        render();
    } else if (mode === 'paint' && boxSelectMode && isPainting && selectionStart) {
        boxCurrent = { wx: Math.floor(wx), wy: Math.floor(wy) };
        render();
    } else if (mode === 'paint' && areaCreationMode && isPainting && areaDrawStart) {
        boxCurrent = { wx: Math.floor(wx), wy: Math.floor(wy) };
        render();
    } else if (mode === 'paint' && isPainting && boxStart) {
        boxCurrent = { wx: Math.floor(wx), wy: Math.floor(wy) };
        render();
    }
});

canvas.addEventListener('pointerup', e => {
    if (draggingSpawn) {
        draggingSpawn = false;
        canvas.releasePointerCapture(e.pointerId);
        saveAnnotations();
        showToast(`Spawn moved to (${playerSpawn.x}, ${playerSpawn.y})`);
        render();
        return;
    }
    if (draggingNpc) {
        canvas.releasePointerCapture(e.pointerId);
        const didMove = _npcClickStart && (Math.abs(e.clientX - _npcClickStart.x) > 4 || Math.abs(e.clientY - _npcClickStart.y) > 4);
        if (didMove) {
            saveAnnotations();
            showToast(`Moved NPC`);
        } else {
            // It was a click, not a drag — select the NPC
            selectedNpc = { zoneId: draggingNpc.zoneId, idx: draggingNpc.idx };
            renderNpcPanel(selectedNpc);
            switchTab('npcs');
        }
        draggingNpc = null;
        _npcClickStart = null;
        render();
        return;
    }
    // Area creation finalize — works in any mode
    if (areaCreationMode && areaDrawStart && boxCurrent) {
        isPainting = false;
        canvas.releasePointerCapture(e.pointerId);
        const x1 = Math.min(areaDrawStart.wx, boxCurrent.wx);
        const y1 = Math.min(areaDrawStart.wy, boxCurrent.wy);
        const x2 = Math.max(areaDrawStart.wx, boxCurrent.wx);
        const y2 = Math.max(areaDrawStart.wy, boxCurrent.wy);
        if (x2 - x1 > 2 && y2 - y1 > 2) {
            pendingArea = { x1, y1, x2, y2 };
            const popup = document.getElementById('area-name-popup');
            popup.style.display = 'block';
            popup.style.left = e.clientX + 'px';
            popup.style.top = e.clientY + 'px';
            document.getElementById('area-name-input').focus();
        }
        areaDrawStart = null; boxCurrent = null;
        render();
        return;
    }
    if (isDragging) {
        isDragging = false;
        wrap.classList.remove('dragging');
        canvas.releasePointerCapture(e.pointerId);
        if (!didDrag && e.button === 0 && mode === 'pan') {
            const {wx, wy} = screenToWorld(e);
            handleClick(wx, wy);
        }
    } else if (selectionDragging) {
        selectionDragging = false;
        canvas.releasePointerCapture(e.pointerId);
        stampSelection();
        render();
    } else if (mode === 'paint' && boxSelectMode && selectionStart && boxCurrent) {
        isPainting = false;
        canvas.releasePointerCapture(e.pointerId);
        const x1 = Math.min(selectionStart.wx, boxCurrent.wx);
        const y1 = Math.min(selectionStart.wy, boxCurrent.wy);
        const x2 = Math.max(selectionStart.wx, boxCurrent.wx);
        const y2 = Math.max(selectionStart.wy, boxCurrent.wy);
        if (x2 > x1 && y2 > y1) {
            selection = { x1, y1, x2, y2 };
            captureSelection();
        }
        selectionStart = null; boxCurrent = null;
        render();
    } else if (mode === 'paint' && areaCreationMode && areaDrawStart && boxCurrent) {
        isPainting = false;
        canvas.releasePointerCapture(e.pointerId);
        const x1 = Math.min(areaDrawStart.wx, boxCurrent.wx);
        const y1 = Math.min(areaDrawStart.wy, boxCurrent.wy);
        const x2 = Math.max(areaDrawStart.wx, boxCurrent.wx);
        const y2 = Math.max(areaDrawStart.wy, boxCurrent.wy);
        if (x2 - x1 > 2 && y2 - y1 > 2) {
            pendingArea = { x1, y1, x2, y2 };
            const popup = document.getElementById('area-name-popup');
            popup.style.display = 'block';
            popup.style.left = e.clientX + 'px';
            popup.style.top = (e.clientY - 30) + 'px';
            const inp = document.getElementById('area-name-input');
            inp.value = '';
            inp.focus();
        }
        areaDrawStart = null; boxCurrent = null;
        render();
    } else if (mode === 'paint' && boxStart && boxCurrent) {
        isPainting = false;
        canvas.releasePointerCapture(e.pointerId);
        boxFill(boxStart, boxCurrent);
        boxStart = null; boxCurrent = null;
        render();
    } else if (mode === 'paint') {
        isPainting = false;
        canvas.releasePointerCapture(e.pointerId);
    }
});

// Prevent context menu on right-click (used for panning)
canvas.addEventListener('contextmenu', e => e.preventDefault());

canvas.addEventListener('wheel', e => {
    e.preventDefault();
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left, my = e.clientY - rect.top;

    if (e.ctrlKey) {
        // Pinch-to-zoom on Mac trackpad (or Ctrl+scroll)
        const worldX = (mx - camX) / zoom, worldY = (my - camY) / zoom;
        zoom *= e.deltaY < 0 ? 1.15 : 0.87;
        zoom = Math.max(0.15, Math.min(zoom, 8));
        camX = mx - worldX * zoom; camY = my - worldY * zoom;
    } else {
        // Two-finger scroll on Mac trackpad = pan
        camX -= e.deltaX;
        camY -= e.deltaY;
    }
    updateStatus(); render();
}, { passive: false });

function handleClick(wx, wy) {
    // Check annotation dots first (click to expand/collapse)
    const clickR = 6 / zoom; // hit radius in world units (slightly larger than dot)
    for (const [zid, anns] of Object.entries(annotations)) {
        const z = zonesMap[zid];
        if (!z) continue;
        const off = z.baked_offset || {x:0,y:0};
        const s = z.baked_scale || 1;
        for (let i = 0; i < anns.length; i++) {
            const ax = off.x + anns[i].x * s;
            const ay = off.y + anns[i].y * s;
            if (Math.abs(wx - ax) < clickR && Math.abs(wy - ay) < clickR) {
                if (selectedAnnotation && selectedAnnotation.zoneId === zid && selectedAnnotation.idx === i) {
                    selectedAnnotation = null; // collapse
                } else {
                    selectedAnnotation = { zoneId: zid, idx: i }; // expand
                }
                render();
                return;
            }
        }
    }
    // Clicked empty space — collapse any expanded annotation
    if (selectedAnnotation) { selectedAnnotation = null; render(); return; }

    // Check NPC clicks
    if (showNpcs) {
        const hitNpc = findNpcAt(wx, wy);
        if (hitNpc) {
            selectedNpc = hitNpc;
            renderNpcPanel(hitNpc);
            switchTab('npcs');
            render();
            return;
        }
    }

    // Check custom areas (smaller areas checked first for precision)
    for (const area of customAreas) {
        if (wx >= area.x1 && wx <= area.x2 && wy >= area.y1 && wy <= area.y2) {
            selectCustomArea(area);
            return;
        }
    }

    for (const z of zones) {
        const off = z.baked_offset || {x:0,y:0};
        const s = z.baked_scale || 1;
        if (wx >= off.x && wx < off.x + (z.width||25)*s && wy >= off.y && wy < off.y + (z.height||25)*s) {
            selectZone(z.id);
            return;
        }
    }
}

let selectedCustomArea = null;

function selectCustomArea(area) {
    selectedCustomArea = area;
    selectedZone = null;
    document.getElementById('panel-title').textContent = area.name;
    document.getElementById('panel-subtitle').textContent = 'Custom area';
    renderCustomAreaInfo(area);
    render();
}

function renderCustomAreaInfo(area) {
    const w = area.x2 - area.x1 + 1, h = area.y2 - area.y1 + 1;
    const rt = REGION_TYPES.find(r => r.id === (area.type || 'area')) || REGION_TYPES[0];
    const content = document.getElementById('panel-content');
    let typeOptions = REGION_TYPES.map(r =>
        `<option value="${r.id}" ${r.id === rt.id ? 'selected' : ''}>${r.name}</option>`
    ).join('');
    content.innerHTML = `
        <div class="field"><label>Region Name</label><input value="${esc(area.name)}" oninput="renameCustomArea('${esc(area.name)}',this.value)"></div>
        <div class="field"><label>Type</label><select onchange="changeAreaType('${esc(area.name)}',this.value)" style="width:100%;background:#0a1628;border:1px solid #1a4a8a;color:#e0e0e0;padding:4px;border-radius:4px">${typeOptions}</select></div>
        <div class="field-row">
            <div class="field"><label>Origin</label><input value="${area.x1}, ${area.y1}" readonly></div>
            <div class="field"><label>Size</label><input value="${w} x ${h}" readonly></div>
        </div>
        <div class="field"><label>Data (JSON)</label><textarea style="width:100%;min-height:40px;background:#0a1628;border:1px solid #1a4a8a;color:#e0e0e0;border-radius:3px;padding:4px;font-size:10px;font-family:monospace;resize:vertical" oninput="saveAreaData('${esc(area.name)}',this.value)">${esc(JSON.stringify(area.data || {}, null, 2))}</textarea></div>
        <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px">
            <button onclick="selectAreaRegion('${esc(area.name)}')" style="width:100%;background:#0f3460;border:1px solid #1a4a8a;color:#e0e0e0;padding:5px;border-radius:4px;cursor:pointer;font-size:11px">Select region for analysis</button>
            <button onclick="deleteCustomArea('${esc(area.name)}')" style="width:100%;background:#7f1d1d;border:1px solid #e94560;color:#e94560;padding:5px;border-radius:4px;cursor:pointer;font-size:11px">Delete region</button>
        </div>
    `;
}

function changeAreaType(areaName, newType) {
    const area = customAreas.find(a => a.name === areaName);
    if (area) { area.type = newType; saveAnnotations(); render(); }
}

function saveAreaData(areaName, jsonStr) {
    const area = customAreas.find(a => a.name === areaName);
    if (!area) return;
    try { area.data = JSON.parse(jsonStr); saveAnnotations(); }
    catch(e) { /* ignore parse errors while typing */ }
}

function renameCustomArea(oldName, newName) {
    const area = customAreas.find(a => a.name === oldName);
    if (area) {
        area.name = newName;
        document.getElementById('panel-title').textContent = newName;
        saveAnnotations();
        render();
    }
}

function selectAreaRegion(areaName) {
    const area = customAreas.find(a => a.name === areaName);
    if (!area) return;
    selection = { x1: area.x1, y1: area.y1, x2: area.x2, y2: area.y2 };
    setMode('paint');
    boxSelectMode = true;
    document.getElementById('btn-box').classList.add('active');
    captureSelection();
    render();
}

function deleteCustomArea(name) {
    customAreas = customAreas.filter(a => a.name !== name);
    selectedCustomArea = null;
    document.getElementById('panel-title').textContent = 'Select a zone';
    document.getElementById('panel-subtitle').textContent = '';
    document.getElementById('panel-content').innerHTML = '';
    saveAnnotations();
    render();
}

// ── Tile Painting ───────────────────────────────────────────────────────
function paintAt(wx, wy) {
    if (terrainReady) {
        // Terrain mode: paint at 1:1 world-tile resolution on active layer
        const tileIdx = eraserOn ? -1 : selectedTileIdx;
        const half = Math.floor(brushSize / 2);
        const baseX = Math.floor(wx), baseY = Math.floor(wy);
        const paintLayer = layerPaints[activeLayer];
        for (let dy = -half; dy < brushSize - half; dy++) {
            for (let dx = -half; dx < brushSize - half; dx++) {
                const tx = baseX + dx, ty = baseY + dy;
                const key = tx + ',' + ty;
                const oldIdx = paintLayer[key] !== undefined ? paintLayer[key] : -1;
                if (oldIdx === tileIdx) continue;
                paintLayer[key] = tileIdx;
                // Invalidate the chunk cache for this tile
                const cx = Math.floor(tx / TERRAIN_CHUNK);
                const cy = Math.floor(ty / TERRAIN_CHUNK);
                const ckey = cx + ',' + cy;
                delete terrainChunks[ckey];
                const lruIdx = chunkLRU.indexOf(ckey);
                if (lruIdx >= 0) chunkLRU.splice(lruIdx, 1);

                undoStack.push({ terrain: true, layer: activeLayer, wx: tx, wy: ty, oldIdx, newIdx: tileIdx });
                redoStack = [];
            }
        }
    } else {
        // Zone mode: paint at zone-tile resolution
        const hit = worldToZoneTile(wx, wy);
        if (!hit) return;
        const z = zonesMap[hit.zoneId];
        if (!z || !z.grid) return;

        const tileIdx = eraserOn ? (1 + (z.tileset < 30 ? z.tileset : 0)) : selectedTileIdx;
        const half = Math.floor(brushSize / 2);

        for (let dy = -half; dy < brushSize - half; dy++) {
            for (let dx = -half; dx < brushSize - half; dx++) {
                const tx = hit.x + dx, ty = hit.y + dy;
                if (tx < 0 || tx >= z.width || ty < 0 || ty >= z.height) continue;

                const oldIdx = z.grid[ty][tx];
                if (oldIdx === tileIdx) continue;

                if (!tileChanges[hit.zoneId]) tileChanges[hit.zoneId] = new Map();
                const key = `${tx},${ty}`;
                const existing = tileChanges[hit.zoneId].get(key);
                const origOld = existing ? existing[2] : oldIdx;
                tileChanges[hit.zoneId].set(key, [tx, ty, origOld, tileIdx]);

                undoStack.push({ zoneId: hit.zoneId, x: tx, y: ty, oldIdx, newIdx: tileIdx });
                redoStack = [];

                z.grid[ty][tx] = tileIdx;
                repaintTile(hit.zoneId, tx, ty, tileIdx);
            }
        }
    }
    saveAnnotations();
    updateStatus();
    render();
}

function boxFill(start, end) {
    const x1 = Math.min(start.wx, end.wx), x2 = Math.max(start.wx, end.wx);
    const y1 = Math.min(start.wy, end.wy), y2 = Math.max(start.wy, end.wy);
    const tileIdx = eraserOn ? -1 : selectedTileIdx;
    const gid = ++undoGroupId;
    const paintLayer = layerPaints[activeLayer];
    const chunksToInvalidate = new Set();
    for (let ty = y1; ty <= y2; ty++) {
        for (let tx = x1; tx <= x2; tx++) {
            const key = tx + ',' + ty;
            const oldIdx = paintLayer[key] !== undefined ? paintLayer[key] : -1;
            if (oldIdx === tileIdx) continue;
            paintLayer[key] = tileIdx;
            undoStack.push({ terrain: true, layer: activeLayer, wx: tx, wy: ty, oldIdx, newIdx: tileIdx, group: gid });
            chunksToInvalidate.add(Math.floor(tx / TERRAIN_CHUNK) + ',' + Math.floor(ty / TERRAIN_CHUNK));
        }
    }
    redoStack = [];
    invalidateChunks(chunksToInvalidate);
    saveAnnotations();
    updateStatus();
    const count = (x2-x1+1)*(y2-y1+1);
    showToast(`Box filled ${count} tiles on ${activeLayer}`);
}

function invalidateChunks(chunks) {
    for (const ckey of chunks) {
        delete terrainChunks[ckey];
        const lruIdx = chunkLRU.indexOf(ckey);
        if (lruIdx >= 0) chunkLRU.splice(lruIdx, 1);
    }
}

function captureSelection() {
    if (!selection) return;
    selectionTiles = {};
    const tileCounts = {}; // spriteIdx -> count
    let emptyCount = 0;
    const paintLayer = layerPaints[activeLayer];
    for (let ty = selection.y1; ty <= selection.y2; ty++) {
        for (let tx = selection.x1; tx <= selection.x2; tx++) {
            const key = tx + ',' + ty;
            // For analysis, check active paint layer first, then base terrain
            let sprite = paintLayer[key];
            if (sprite === undefined && activeLayer === 'ground') {
                if (terrainOverlay) sprite = terrainOverlay[key];
                if (sprite === undefined && terrainGround) sprite = terrainGround[key];
            }
            const rx = tx - selection.x1, ry = ty - selection.y1;
            if (sprite !== undefined) {
                selectionTiles[rx + ',' + ry] = sprite;
                tileCounts[sprite] = (tileCounts[sprite] || 0) + 1;
            } else {
                selectionTiles[rx + ',' + ry] = -1;
                emptyCount++;
            }
        }
    }
    // Store analysis for panel display
    selectionAnalysis = { tileCounts, emptyCount, total: Object.keys(selectionTiles).length };
    const count = Object.keys(selectionTiles).length;
    showToast(`Selected ${count} tiles`);
    renderSelectionTab();
    switchTab('selection');
}

function renderSelectionTab() {
    const content = document.getElementById('panel-content');
    if (!selectionAnalysis || !selection) {
        content.innerHTML = '<p style="color:#666;text-align:center;margin-top:30px">Use Select mode to box-select a region</p>';
        return;
    }
    const { tileCounts, emptyCount, total } = selectionAnalysis;
    const w = selection.x2 - selection.x1 + 1, h = selection.y2 - selection.y1 + 1;
    let html = `<div style="margin-bottom:8px"><strong style="font-size:12px">Selection: ${w}x${h} (${total} tiles)</strong></div>`;
    html += `<div style="font-size:10px;color:#888;margin-bottom:6px">Origin: ${selection.x1},${selection.y1} | Active layer: <strong style="color:#e94560">${activeLayer}</strong></div>`;

    // Sort tile types by count descending
    const entries = Object.entries(tileCounts).map(([idx, count]) => [parseInt(idx), count]).sort((a,b) => b[1] - a[1]);
    if (emptyCount > 0) entries.push([-1, emptyCount]);

    html += '<div style="margin-bottom:8px">';
    for (const [idx, count] of entries) {
        const pct = ((count / total) * 100).toFixed(1);
        let label, thumbStyle;
        if (idx === -1) {
            label = 'Empty/void';
            thumbStyle = 'background:#333';
        } else {
            const { sheet, localIdx } = getSheetLocalIdx(idx);
            label = `#${idx} (${sheet.id}:${localIdx})`;
            if (sheet.img) {
                const sz = 24;
                const bgW = sheet.cols * sz, bgH = sheet.rows * sz;
                thumbStyle = `background-image:url('${sheet.file}');background-size:${bgW}px ${bgH}px;background-position:-${(localIdx%sheet.cols)*sz}px -${Math.floor(localIdx/sheet.cols)*sz}px;image-rendering:pixelated`;
            } else {
                thumbStyle = 'background:#555';
            }
        }
        html += `<div style="display:flex;align-items:center;gap:6px;padding:4px 6px;background:#0d1b2a;border:1px solid #1a4a8a;border-radius:3px;margin-bottom:2px;font-size:11px">
            <div style="width:24px;height:24px;border:1px solid #1a4a8a;border-radius:2px;flex-shrink:0;${thumbStyle}"></div>
            <span style="flex:1">${label} <span style="color:#888">(${count} / ${pct}%)</span></span>
            <button onclick="selectionReplace(${idx})" style="background:#0f3460;border:1px solid #1a4a8a;color:#e0e0e0;padding:2px 6px;border-radius:3px;cursor:pointer;font-size:9px" title="Replace these with current brush">Repl</button>
            <button onclick="selectionRemove(${idx})" style="background:#7f1d1d;border:1px solid #e94560;color:#e94560;padding:2px 6px;border-radius:3px;cursor:pointer;font-size:9px" title="Erase to void">Del</button>
        </div>`;
    }
    html += '</div>';
    html += `<div style="display:flex;flex-direction:column;gap:4px;margin-top:8px">
        <div style="display:flex;gap:4px">
            <button onclick="selectionReplaceAll()" style="flex:1;background:#166534;border:1px solid #4ade80;color:#4ade80;padding:5px;border-radius:4px;cursor:pointer;font-size:10px">Fill ALL with brush</button>
            <button onclick="selectionFillEmpty()" style="flex:1;background:#1e3a5f;border:1px solid #60a5fa;color:#60a5fa;padding:5px;border-radius:4px;cursor:pointer;font-size:10px">Fill empty only</button>
        </div>
        <div style="display:flex;gap:4px">
            <button onclick="selectionRemoveAll()" style="flex:1;background:#7f1d1d;border:1px solid #e94560;color:#e94560;padding:5px;border-radius:4px;cursor:pointer;font-size:10px">Remove ALL tiles</button>
            <button onclick="clearSelection()" style="flex:1;background:#0f3460;border:1px solid #1a4a8a;color:#e0e0e0;padding:5px;border-radius:4px;cursor:pointer;font-size:10px">Clear selection</button>
        </div>
        <div style="margin-top:6px;padding:6px;background:#0d1b2a;border:1px solid #1a4a8a;border-radius:4px">
            <div style="font-size:10px;color:#888;margin-bottom:4px">Move selected tiles to layer:</div>
            <div style="display:flex;gap:3px;flex-wrap:wrap">
                ${PAINT_LAYERS.filter(l => l.id !== activeLayer).map(l =>
                    '<button onclick="moveSelectionToLayer(\'' + l.id + '\')" style="flex:1;background:#1e3a5f;border:1px solid #60a5fa;color:#60a5fa;padding:4px 6px;border-radius:3px;cursor:pointer;font-size:9px;min-width:50px">' + l.name + '</button>'
                ).join('')}
            </div>
        </div>
    </div>`;
    content.innerHTML = html;
}

function selectionRemove(targetIdx) {
    if (!selection) return;
    const gid = ++undoGroupId;
    const paintLayer = layerPaints[activeLayer];
    let count = 0;
    const chunksToInvalidate = new Set();
    for (let ty = selection.y1; ty <= selection.y2; ty++) {
        for (let tx = selection.x1; tx <= selection.x2; tx++) {
            const key = tx + ',' + ty;
            let current = getLayerTile(key);
            if (current === targetIdx) {
                paintLayer[key] = -1;
                undoStack.push({ terrain: true, layer: activeLayer, wx: tx, wy: ty, oldIdx: current, newIdx: -1, group: gid });
                chunksToInvalidate.add(Math.floor(tx / TERRAIN_CHUNK) + ',' + Math.floor(ty / TERRAIN_CHUNK));
                count++;
            }
        }
    }
    redoStack = [];
    invalidateChunks(chunksToInvalidate);
    saveAnnotations(); updateStatus();
    captureSelection(); // refresh analysis
    showToast(`Removed ${count} tiles`);
    render();
}

