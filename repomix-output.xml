	# Wilderness area
	"cutthroat": {"ps": Vector2i(106, -47), "es": Vector2i(-24, -53)},
	"frostpass": {"ps": Vector2i(-15, -206), "es": Vector2i(-57, -135)},
	"cold2": {"ps": Vector2i(-15, -206), "es": Vector2i(-57, -135)},
	# Graveyard area
